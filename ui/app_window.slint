import { Theme } from "theme.slint";
import { UnlockScreen } from "screens/unlock_screen.slint";
import { MainScreen, FilterItem } from "screens/main_screen.slint";
import { EntryOverview } from "components/entry_item.slint";
import { EntryDetailData, PasswordHistoryItem, SecondaryPasskeyItem, SecondaryTotpItem, DetailCustomFieldItem, DetailLinkItem, DetailAttachmentItem } from "screens/entry_detail.slint";
import { GeneratorDialog, GeneratorOptions } from "screens/generator_dialog.slint";
import { SettingsScreen, PortRuleItem, PortRuleRow, SubdomainRuleItem, SubdomainRuleRow, HsvColorResult } from "screens/settings_screen.slint";
import { SettingsData } from "settings/settings_modal.slint";
import { EditModal as EditDialog, EntryEditData } from "edit/edit_modal.slint";
import { DropdownOption } from "components/dropdown_filter.slint";
import { ZoomShortcutHandler } from "components/widgets/zoom_shortcut_handler.slint";
import { VaultHealthModal, HealthIssueItem } from "health/vault_health_modal.slint";
import { DuplicatesModal, DuplicateGroupItem } from "duplicates/duplicates_modal.slint";
import { TitleNormalizerModal, TitleNormalizationGroupItem } from "titles/title_normalizer_modal.slint";
import { CategoryManagerModal } from "categories/category_manager_modal.slint";
import { ProfileManagerModal, ProfileManagerItem } from "profiles/profile_manager_modal.slint";
import { PasswordHistoryModal, GeneratedPasswordItem } from "generator/password_history_modal.slint";
import { P2pSyncModal } from "dialogs/p2p_sync_modal.slint";

export { Theme, FilterItem, EntryOverview, EntryDetailData, PasswordHistoryItem, SecondaryPasskeyItem, SecondaryTotpItem, DetailCustomFieldItem, DetailLinkItem, DetailAttachmentItem, GeneratorOptions, SettingsData, EntryEditData, DropdownOption, PortRuleItem, PortRuleRow, SubdomainRuleItem, SubdomainRuleRow, HsvColorResult, HealthIssueItem, DuplicateGroupItem, TitleNormalizationGroupItem, ProfileManagerItem, GeneratedPasswordItem }

export component AppWindow inherits Window {
    title: "Bóveda Local Desktop";
    preferred-width: 1080px;
    preferred-height: 680px;
    min-width: 360px;
    min-height: 260px;
    background: Theme.background;

    // Propiedades de Estado
    in-out property <bool> boveda-desbloqueada: false;
    in-out property <string> ruta-boveda: "";
    in-out property <string> error-desbloqueo: "";
    in-out property <bool> desbloqueando: false;
    in-out property <bool> biometria-disponible: false;
    in-out property <bool> auto-cargar-ultima: true;

    // Datos de la Bóveda en Memoria
    in-out property <[FilterItem]> tipos-filtro: [];
    in-out property <[FilterItem]> categorias-filtro: [];
    in-out property <[DropdownOption]> tipos-dropdown: [];
    in-out property <[DropdownOption]> categorias-dropdown: [];
    in-out property <[DropdownOption]> perfiles-filtro: [];
    in-out property <[DropdownOption]> etiquetas-filtro: [];
    in-out property <string> filtro-tipo-actual: "TODOS";
    in-out property <string> filtro-categoria-actual: "TODAS";
    in-out property <string> filtro-perfil-actual: "TODOS";
    in-out property <string> filtro-etiqueta-actual: "TODAS";
    in-out property <string> entrada-seleccionada-id: "";
    
    in-out property <[EntryOverview]> lista-entradas: [];
    in-out property <EntryDetailData> detalle-actual;
    in-out property <string> texto-notificacion: "";
    in-out property <length> lista-viewport-y: 0px;
    in-out property <bool> solo-favoritos: false;
    in-out property <string> orden-actual: "NOMBRE_AZ";
    in-out property <int> conteo-seleccionadas: 0;
    in-out property <bool> todas-seleccionadas: false;
    in-out property <string> resumen-unificacion-lote: "";
    in-out property <string> modo-dialogo-lote: "";
    in-out property <string> texto-dialogo-lote: "";

    // Contadores reactivos de auditoría y herramientas en el Sidebar
    in-out property <int> conteo-favoritos: 0;
    in-out property <int> conteo-salud-alertas: 0;
    in-out property <int> conteo-duplicados: 0;
    in-out property <int> conteo-papelera: 0;
    in-out property <int> conteo-perfiles: 0;
    in-out property <int> conteo-categorias: 0;
    in-out property <int> total-entradas-boveda: 0;
    in-out property <int> conteo-entradas-filtradas: 0;
    in-out property <int> conteo-totp: 0;
    in-out property <int> conteo-passkeys: 0;
    in-out property <int> conteo-titulos-sucios: 0;
    in-out property <int> conteo-historial-generador: 0;
    in-out property <string> perfil-argon2-nombre: "ESTÁNDAR";

    // Estado de Modales de Salud, Duplicados, Normalizador, Categorías, Perfiles e Historial
    in-out property <bool> mostrar-salud: false;
    in-out property <int> salud-puntuacion: 100;
    in-out property <string> salud-pestana-activa: "REPETIDAS";
    in-out property <int> salud-conteo-caducadas: 0;
    in-out property <int> salud-conteo-repetidas: 0;
    in-out property <int> salud-conteo-comunes: 0;
    in-out property <int> salud-conteo-debiles: 0;
    in-out property <int> salud-conteo-antiguas: 0;
    in-out property <int> salud-conteo-ignoradas: 0;
    in-out property <[HealthIssueItem]> salud-items: [];

    in-out property <bool> mostrar-duplicados: false;
    in-out property <string> duplicados-filtro-activo: "TODOS";
    in-out property <[DuplicateGroupItem]> duplicados-grupos: [];

    in-out property <bool> mostrar-normalizador-titulos: false;
    in-out property <string> titulos-formato-activo: "CAPITALIZADO";
    in-out property <bool> titulos-respetar-personalizados: true;
    in-out property <[TitleNormalizationGroupItem]> titulos-grupos: [];

    in-out property <bool> mostrar-gestor-categorias: false;
    in-out property <bool> mostrar-gestor-perfiles: false;
    in-out property <[ProfileManagerItem]> perfiles-gestor: [];

    in-out property <bool> mostrar-historial-generador: false;
    in-out property <[GeneratedPasswordItem]> historial-generador: [];

    // Estado del Diálogo P2P Sync
    in-out property <bool> mostrar-sync-p2p: false;
    in-out property <image> sync-p2p-qr;
    in-out property <string> sync-p2p-huella: "00:00:00:00:00:00";
    in-out property <string> sync-p2p-estado-texto: "Esperando escaneo móvil...";
    in-out property <int> sync-p2p-estado-codigo: 0;
    in-out property <string> sync-p2p-red-info: "";
    in-out property <string> sync-p2p-alias-remoto: "";

    in-out property <int> ajustes-categoria-activa: 1;
    in-out property <int> ajustes-subseccion-activa: 1;
    in-out property <string> ajustes-registro-eventos: "Sesión iniciada con cifrado autenticado AES-256-GCM y derivación Argon2id.";

    // Modales y Diálogos
    in-out property <bool> mostrar-editor: false;
    in-out property <bool> es-nueva-entrada: true;
    in-out property <EntryEditData> editor-datos;

    in-out property <bool> mostrar-generador: false;
    in-out property <GeneratorOptions> generador-opciones: {
        longitud: 20,
        mayusculas: true,
        minusculas: true,
        numeros: true,
        simbolos: true,
        evitar_ambiguos: true,
        modo_frase: false,
        numero_palabras: 4,
        separador: "-",
        capitalizar_palabras: true,
    };
    in-out property <string> generador-resultado: "";
    in-out property <int> generador-fuerza-puntuacion: 85;
    in-out property <string> generador-fuerza-etiqueta: "Fuerte";
    in-out property <string> generador-destino: "";

    in-out property <bool> mostrar-ajustes: false;
    in-out property <SettingsData> ajustes-datos: {
        mostrar_ola_niagara: true,
        incluir_enie_niagara: true,
        criterio_ordenacion: "NOMBRE_AZ",
        fijar_anclados_arriba: true,
        nombre_boveda: "Mi Bóveda Principal",
        color_acento: "menta",
        modo_tema: "oscuro",
    };
    in-out property <string> ajustes-error: "";
    in-out property <string> ajustes-exito: "";
    in-out property <bool> ajustes-cambiando-clave: false;
    in-out property <[PortRuleRow]> ajustes-filas-puertos: [];
    in-out property <[SubdomainRuleRow]> ajustes-filas-subdominios: [];

    in-out property <string> ajustes-hex-usuario: "#2563EB";
    in-out property <string> ajustes-hex-password: "#EAB308";
    in-out property <string> ajustes-hex-totp: "#F97316";
    in-out property <string> ajustes-hex-passkey: "#8B5CF6";
    in-out property <string> ajustes-hex-url: "#06B6D4";
    in-out property <string> ajustes-hex-app: "#16A34A";

    // Callbacks conectados a Rust
    callback intentar-desbloquear(string, string);
    callback examinar-archivo();
    callback desbloquear-biometria();
    callback bloquear-boveda();
    callback seleccionar-tipo(string);
    callback seleccionar-categoria(string);
    callback seleccionar-perfil(string);
    callback seleccionar-etiqueta(string);
    callback seleccionar-entrada(string);
    callback buscar(string);
    callback copiar-campo(string, string);
    callback cerrar-detalle();
    callback saltar-a-letra(string);

    callback abrir-nueva-entrada();
    callback abrir-editar-entrada(string);
    callback guardar-entrada(EntryEditData);
    callback mover-a-papelera(string);
    callback restaurar-entrada(string);
    callback eliminar-definitivo(string);
    callback alternar-favorito(string);
    callback alternar-anclado(string);
    callback copiar-totp(string);
    callback restaurar-password-historial(string, string);
    callback eliminar-password-historial(string, string);
    callback promover-passkey-secundaria(string, string);
    callback eliminar-passkey-secundaria(string, string);
    callback promover-totp-secundario(string, string);
    callback eliminar-totp-secundario(string, string);
    callback guardar-adjunto(string, string);

    // Callbacks de selección múltiple y acciones en lote
    callback alternar-seleccion-entrada(string);
    callback alternar-seleccion-grupo(string);
    callback cancelar-seleccion();
    callback alternar-seleccionar-todas();
    callback lote-favorito();
    callback lote-anclar();
    callback lote-salud();
    callback lote-exportar();
    callback lote-papelera();
    callback lote-restaurar();
    callback lote-eliminar-definitivo();
    callback preparar-unificacion-lote();
    callback confirmar-renombrar-lote(string);
    callback confirmar-categoria-lote(string);
    callback confirmar-unificar-lote(string);

    callback abrir-generador(string);
    callback regenerar-contrasena(GeneratorOptions);
    callback aplicar-contrasena(string);

    callback abrir-ajustes();
    callback guardar-ajustes(SettingsData);
    callback restaurar-predeterminados();
    callback restaurar-campo(string);
    callback restaurar-seccion(string);
    callback cambiar-clave-maestra(string, string, string);
    callback exportar-json();
    callback exportar-csv();
    callback importar-bitwarden();
    callback importar-csv();
    callback fusionar-boveda();
    callback auditoria-salud();
    callback alternar-biometria(bool);
    callback agregar-puerto(string, string);
    callback eliminar-puerto(string);
    callback agregar-subdominio(string);
    callback eliminar-subdominio(string);
    callback reportar-ancho-chips(float);
    callback calcular-hsv(float, float, float) -> HsvColorResult;
    callback aplicar-color-indicador(string, color, string);

    // Callbacks menú de 3 puntos y grupos
    callback alternar-grupo(string);
    callback alternar-solo-favoritos();
    callback normalizar-titulos();
    callback crear-nuevo-tipo(string);
    callback cambiar-orden(string);
    callback exportar-bvda();
    callback navegar-apariencia();
    callback abrir-ayuda();

    // Callbacks para Salud, Duplicados, Títulos, Categorías, Perfiles, Historial y Ajustes
    callback abrir-salud();
    callback seleccionar-pestana-salud(string);
    callback rotar-clave-salud(string);
    callback alternar-ignorar-salud-individual(string);
    callback abrir-duplicados();
    callback seleccionar-filtro-duplicados(string);
    callback unificar-grupo-duplicados(string);
    callback unificar-todos-duplicados();
    callback cambiar-formato-titulos(string);
    callback alternar-respetar-personalizados-titulos();
    callback aplicar-normalizacion-todos-titulos();
    callback aplicar-normalizacion-grupo-titulos(string, string);
    callback abrir-gestor-categorias();
    callback guardar-categoria(string, string, string);
    callback eliminar-categoria(string);
    callback abrir-gestor-perfiles();
    callback guardar-perfil(string, string, string, string, string, string, string);
    callback eliminar-perfil(string);
    callback abrir-historial-claves();
    callback limpiar-historial-claves();
    callback vaciar-papelera();
    callback generar-kit-emergencia();
    callback buscar-ajuste(string);
    callback abrir-escaner-qr();
    callback cancelar-sincronizacion-p2p();
    callback confirmar-sincronizacion-p2p();

    // Callbacks desacoplados de Zoom Global (Ctrl +, Ctrl -, Ctrl 0)
    callback aumentar-zoom();
    callback reducir-zoom();
    callback restaurar-zoom();

    ZoomShortcutHandler {
        aumentar-zoom => { root.aumentar-zoom(); }
        reducir-zoom => { root.reducir-zoom(); }
        restaurar-zoom => { root.restaurar-zoom(); }

        // Pantalla de Desbloqueo
        if !boveda-desbloqueada : UnlockScreen {
            ruta-boveda <=> root.ruta-boveda;
            error-mensaje: root.error-desbloqueo;
            cargando: root.desbloqueando;
            auto-cargar-ultima <=> root.auto-cargar-ultima;
            biometria-disponible: root.biometria-disponible;

            intentar-desbloquear(ruta, pass) => {
                root.intentar-desbloquear(ruta, pass);
            }
            examinar-archivo => {
                root.examinar-archivo();
            }
            desbloquear-biometria => {
                root.desbloquear-biometria();
            }
        }

        // Pantalla Principal Tri-Panel (Visible si desbloqueada y no está en Ajustes)
        if boveda-desbloqueada && !mostrar-ajustes : MainScreen {
            tipos-filtro: root.tipos-filtro;
            categorias-filtro: root.categorias-filtro;
            tipos-dropdown: root.tipos-dropdown;
            categorias-dropdown: root.categorias-dropdown;
            perfiles-filtro: root.perfiles-filtro;
            etiquetas-filtro: root.etiquetas-filtro;
            filtro-tipo-actual: root.filtro-tipo-actual;
            filtro-categoria-actual: root.filtro-categoria-actual;
            filtro-perfil-actual: root.filtro-perfil-actual;
            filtro-etiqueta-actual: root.filtro-etiqueta-actual;
            entrada-seleccionada-id: root.entrada-seleccionada-id;
            lista-entradas: root.lista-entradas;
            detalle-actual: root.detalle-actual;
            texto-notificacion: root.texto-notificacion;
            mostrar-ola-niagara: root.ajustes-datos.mostrar_ola_niagara;
            incluir-enie-niagara: root.ajustes-datos.incluir_enie_niagara;
            lista-viewport-y <=> root.lista-viewport-y;
            solo-favoritos: root.solo-favoritos;
            orden-actual: root.orden-actual;
            conteo-seleccionadas: root.conteo-seleccionadas;
            todas-seleccionadas: root.todas-seleccionadas;
            resumen-unificacion-lote: root.resumen-unificacion-lote;
            modo-dialogo-lote <=> root.modo-dialogo-lote;
            texto-dialogo-lote <=> root.texto-dialogo-lote;
            conteo-favoritos: root.conteo-favoritos;
            conteo-salud-alertas: root.conteo-salud-alertas;
            conteo-duplicados: root.conteo-duplicados;
            conteo-papelera: root.conteo-papelera;
            conteo-perfiles: root.conteo-perfiles;
            conteo-categorias: root.conteo-categorias;
            total-entradas-boveda: root.total-entradas-boveda;
            conteo-entradas-filtradas: root.conteo-entradas-filtradas;
            conteo-totp: root.conteo-totp;
            conteo-passkeys: root.conteo-passkeys;
            conteo-titulos-sucios: root.conteo-titulos-sucios;
            conteo-historial-generador: root.conteo-historial-generador;
            perfil-argon2-nombre: root.perfil-argon2-nombre;

            seleccionar-tipo(t) => { root.seleccionar-tipo(t); }
            seleccionar-categoria(c) => { root.seleccionar-categoria(c); }
            seleccionar-perfil(p) => { root.seleccionar-perfil(p); }
            seleccionar-etiqueta(e) => { root.seleccionar-etiqueta(e); }
            seleccionar-entrada(id) => { root.seleccionar-entrada(id); }
            buscar(q) => { root.buscar(q); }
            bloquear-boveda => { root.bloquear-boveda(); }
            copiar-campo(v, n) => { root.copiar-campo(v, n); }
            cerrar-detalle => { root.cerrar-detalle(); }
            saltar-a-letra(l) => { root.saltar-a-letra(l); }

            abrir-nueva-entrada => { root.abrir-nueva-entrada(); }
            abrir-ajustes => { root.abrir-ajustes(); }
            editar-entrada(id) => { root.abrir-editar-entrada(id); }
            mover-papelera(id) => { root.mover-a-papelera(id); }
            restaurar-entrada(id) => { root.restaurar-entrada(id); }
            eliminar-definitivo(id) => { root.eliminar-definitivo(id); }
            alternar-favorito(id) => { root.alternar-favorito(id); }
            alternar-anclado(id) => { root.alternar-anclado(id); }
            copiar-totp(id) => { root.copiar-totp(id); }
            restaurar-password-historial(id, pw) => { root.restaurar-password-historial(id, pw); }
            eliminar-password-historial(id, pw) => { root.eliminar-password-historial(id, pw); }
            promover-passkey-secundaria(id, cid) => { root.promover-passkey-secundaria(id, cid); }
            eliminar-passkey-secundaria(id, cid) => { root.eliminar-passkey-secundaria(id, cid); }
            promover-totp-secundario(id, tid) => { root.promover-totp-secundario(id, tid); }
            eliminar-totp-secundario(id, tid) => { root.eliminar-totp-secundario(id, tid); }
            guardar-adjunto(id, aid) => { root.guardar-adjunto(id, aid); }

            alternar-seleccion-entrada(id) => { root.alternar-seleccion-entrada(id); }
            alternar-seleccion-grupo(g) => { root.alternar-seleccion-grupo(g); }
            cancelar-seleccion => { root.cancelar-seleccion(); }
            alternar-seleccionar-todas => { root.alternar-seleccionar-todas(); }
            lote-favorito => { root.lote-favorito(); }
            lote-anclar => { root.lote-anclar(); }
            lote-salud => { root.lote-salud(); }
            lote-exportar => { root.lote-exportar(); }
            lote-papelera => { root.lote-papelera(); }
            lote-restaurar => { root.lote-restaurar(); }
            lote-eliminar-definitivo => { root.lote-eliminar-definitivo(); }
            preparar-unificacion-lote => { root.preparar-unificacion-lote(); }
            confirmar-renombrar-lote(t) => { root.confirmar-renombrar-lote(t); }
            confirmar-categoria-lote(c) => { root.confirmar-categoria-lote(c); }
            confirmar-unificar-lote(t) => { root.confirmar-unificar-lote(t); }

            alternar-grupo(c) => { root.alternar-grupo(c); }
            alternar-solo-favoritos => { root.alternar-solo-favoritos(); }
            normalizar-titulos => { root.normalizar-titulos(); }
            crear-nuevo-tipo(t) => { root.crear-nuevo-tipo(t); }
            cambiar-orden(o) => { root.cambiar-orden(o); }
            importar-bitwarden => { root.importar-bitwarden(); }
            importar-csv => { root.importar-csv(); }
            fusionar-boveda => { root.fusionar-boveda(); }
            exportar-bvda => { root.exportar-bvda(); }
            exportar-json => { root.exportar-json(); }
            exportar-csv => { root.exportar-csv(); }
            navegar-apariencia => { root.navegar-apariencia(); }
            abrir-ayuda => { root.abrir-ayuda(); }
            abrir-salud => { root.abrir-salud(); }
            abrir-duplicados => { root.abrir-duplicados(); }
            abrir-gestor-categorias => { root.abrir-gestor-categorias(); }
            abrir-gestor-perfiles => { root.abrir-gestor-perfiles(); }
            abrir-generador-sidebar => { root.abrir-generador(""); }
            abrir-escaner-qr => { root.abrir-escaner-qr(); }
            abrir-historial-claves => { root.abrir-historial-claves(); }
            vaciar-papelera => { root.vaciar-papelera(); }
        }

        // Pantalla Integrada de Ajustes a Todo lo Ancho (Paridad Canónica con Android)
        if boveda-desbloqueada && mostrar-ajustes : SettingsScreen {
            width: 100%;
            height: 100%;
            datos <=> root.ajustes-datos;
            mensaje-error: root.ajustes-error;
            mensaje-exito: root.ajustes-exito;
            cambiando-clave: root.ajustes-cambiando-clave;
            filas-puertos: root.ajustes-filas-puertos;
            filas-subdominios: root.ajustes-filas-subdominios;
            hex-usuario: root.ajustes-hex-usuario;
            hex-password: root.ajustes-hex-password;
            hex-totp: root.ajustes-hex-totp;
            hex-passkey: root.ajustes-hex-passkey;
            hex-url: root.ajustes-hex-url;
            hex-app: root.ajustes-hex-app;
            categoria-activa <=> root.ajustes-categoria-activa;
            subseccion-activa <=> root.ajustes-subseccion-activa;
            registro-eventos: root.ajustes-registro-eventos;

            guardar(d) => { root.guardar-ajustes(d); }
            restaurar-predeterminados => { root.restaurar-predeterminados(); }
            restaurar-campo(c) => { root.restaurar-campo(c); }
            restaurar-seccion(s) => { root.restaurar-seccion(s); }
            cambiar-clave-maestra(act, nva, conf) => { root.cambiar-clave-maestra(act, nva, conf); }
            volver => { root.mostrar-ajustes = false; }
            exportar-json => { root.exportar-json(); }
            exportar-csv => { root.exportar-csv(); }
            importar-bitwarden => { root.importar-bitwarden(); }
            importar-csv => { root.importar-csv(); }
            fusionar-boveda => { root.fusionar-boveda(); }
            generar-kit-emergencia => { root.generar-kit-emergencia(); }
            vaciar-papelera => { root.vaciar-papelera(); }
            abrir-gestor-categorias => { root.abrir-gestor-categorias(); }
            abrir-gestor-perfiles => { root.abrir-gestor-perfiles(); }
            abrir-generador => { root.abrir-generador("ajustes"); }
            auditoria-salud => { root.auditoria-salud(); }
            alternar-biometria(act) => { root.alternar-biometria(act); }
            agregar-puerto(p, n) => { root.agregar-puerto(p, n); }
            eliminar-puerto(id) => { root.eliminar-puerto(id); }
            agregar-subdominio(s) => { root.agregar-subdominio(s); }
            eliminar-subdominio(id) => { root.eliminar-subdominio(id); }
            reportar-ancho-chips(w) => { root.reportar-ancho-chips(w); }
            calcular-hsv(h, s, v) => { return root.calcular-hsv(h, s, v); }
            aplicar-color-indicador(c, col, hex) => { root.aplicar-color-indicador(c, col, hex); }
            aumentar-zoom => { root.aumentar-zoom(); }
            reducir-zoom => { root.reducir-zoom(); }
            restaurar-zoom => { root.restaurar-zoom(); }
            buscar-ajuste(q) => { root.buscar-ajuste(q); }
        }

        // Diálogo Modal: Edición de Entrada
        if mostrar-editor : EditDialog {
            datos <=> root.editor-datos;
            es-nueva: root.es-nueva-entrada;
            opciones-categorias: root.categorias-dropdown;
            opciones-perfiles: root.perfiles-filtro;

            guardar(d) => { root.guardar-entrada(d); }
            abrir-generador(destino) => { root.abrir-generador(destino); }
            cancelar => { root.mostrar-editor = false; }
        }

        // Diálogo Modal: Generador de Contraseñas
        if mostrar-generador : GeneratorDialog {
            options <=> root.generador-opciones;
            contrasena-generada: root.generador-resultado;
            fuerza-puntuacion: root.generador-fuerza-puntuacion;
            fuerza-etiqueta: root.generador-fuerza-etiqueta;
            mostrar-boton-aplicar: root.generador-destino != "";

            regenerar(opt) => { root.regenerar-contrasena(opt); }
            copiar(p) => { root.copiar-campo(p, "Contraseña Generada"); }
            aplicar(p) => { root.aplicar-contrasena(p); }
            cerrar => { root.mostrar-generador = false; }
        }

        // Diálogo Modal: Salud de la Bóveda Interactiva
        if mostrar-salud : VaultHealthModal {
            puntuacion: root.salud-puntuacion;
            pestana-activa: root.salud-pestana-activa;
            conteo-caducadas: root.salud-conteo-caducadas;
            conteo-repetidas: root.salud-conteo-repetidas;
            conteo-comunes: root.salud-conteo-comunes;
            conteo-debiles: root.salud-conteo-debiles;
            conteo-antiguas: root.salud-conteo-antiguas;
            conteo-ignoradas: root.salud-conteo-ignoradas;
            items: root.salud-items;

            seleccionar-pestana(t) => { root.seleccionar-pestana-salud(t); }
            rotar-clave-rapida(id) => { root.rotar-clave-salud(id); }
            alternar-ignorar(id) => { root.alternar-ignorar-salud-individual(id); }
            editar-entrada(id) => {
                root.mostrar-salud = false;
                root.abrir-editar-entrada(id);
            }
            cerrar => { root.mostrar-salud = false; }
        }

        // Diálogo Modal: Detector y Unificador de Duplicados
        if mostrar-duplicados : DuplicatesModal {
            filtro-activo: root.duplicados-filtro-activo;
            grupos: root.duplicados-grupos;

            seleccionar-filtro(f) => { root.seleccionar-filtro-duplicados(f); }
            unificar-grupo(ids) => { root.unificar-grupo-duplicados(ids); }
            unificar-todos => { root.unificar-todos-duplicados(); }
            cerrar => { root.mostrar-duplicados = false; }
        }

        // Diálogo Modal: Normalizador y Renombrador Interactivo de Títulos
        if mostrar-normalizador-titulos : TitleNormalizerModal {
            formato-activo: root.titulos-formato-activo;
            respetar-personalizados: root.titulos-respetar-personalizados;
            grupos: root.titulos-grupos;

            cambiar-formato(f) => { root.cambiar-formato-titulos(f); }
            alternar-respetar-personalizados => { root.alternar-respetar-personalizados-titulos(); }
            aplicar-todos => { root.aplicar-normalizacion-todos-titulos(); }
            aplicar-grupo(clave, prop) => { root.aplicar-normalizacion-grupo-titulos(clave, prop); }
            cerrar => { root.mostrar-normalizador-titulos = false; }
        }

        // Diálogo Modal: Gestión CRUD de Categorías
        if mostrar-gestor-categorias : CategoryManagerModal {
            categorias: root.categorias-filtro;
            guardar-categoria(id, nom, ico) => { root.guardar-categoria(id, nom, ico); }
            eliminar-categoria(id) => { root.eliminar-categoria(id); }
            cerrar => { root.mostrar-gestor-categorias = false; }
        }

        // Diálogo Modal: Gestión CRUD de Perfiles e Identidades
        if mostrar-gestor-perfiles : ProfileManagerModal {
            perfiles: root.perfiles-gestor;
            guardar-perfil(id, nom, cor, sec, tdoc, doc, pref) => { root.guardar-perfil(id, nom, cor, sec, tdoc, doc, pref); }
            eliminar-perfil(id) => { root.eliminar-perfil(id); }
            cerrar => { root.mostrar-gestor-perfiles = false; }
        }

        // Diálogo Modal: Historial de Contraseñas Generadas
        if mostrar-historial-generador : PasswordHistoryModal {
            historial: root.historial-generador;
            copiar-clave(c) => { root.copiar-campo(c, "Contraseña del Historial"); }
            limpiar-historial => { root.limpiar-historial-claves(); }
            cerrar => { root.mostrar-historial-generador = false; }
        }

        // Diálogo Modal: Sincronización Segura P2P
        if mostrar-sync-p2p : P2pSyncModal {
            qr-code: root.sync-p2p-qr;
            huella-visual: root.sync-p2p-huella;
            estado-texto: root.sync-p2p-estado-texto;
            estado-codigo: root.sync-p2p-estado-codigo;
            red-info: root.sync-p2p-red-info;
            alias-remoto: root.sync-p2p-alias-remoto;

            confirmar => { root.confirmar-sincronizacion-p2p(); }
            cancelar => { root.cancelar-sincronizacion-p2p(); }
        }
    }
}
