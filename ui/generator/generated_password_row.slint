import { Theme } from "../theme.slint";

export struct GeneratedPasswordItem {
    clave: string,
    fecha: string,
    etiqueta-fuerza: string,
    puntuacion: int,
}

export component GeneratedPasswordRow inherits Rectangle {
    in property <GeneratedPasswordItem> item;
    callback copiar(string);

    width: 100%;
    height: 48px;
    background: Theme.background;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.item.clave;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.item.fecha + " · Fuerza: " + root.item.etiqueta-fuerza + " (" + root.item.puntuacion + "/100)";
                color: Theme.text-muted;
                font-size: 10px;
            }
        }

        VerticalLayout {
            alignment: center;
            btn-copy := TouchArea {
                width: 72px;
                height: 28px;
                mouse-cursor: pointer;
                clicked => { root.copiar(root.item.clave); }

                Rectangle {
                    background: btn-copy.has-hover ? Theme.surface-hover : Theme.surface;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        text: "Copiar";
                        color: Theme.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
