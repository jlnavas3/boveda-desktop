import { Theme } from "../theme.slint";
import { AppIcon } from "../components/widgets/app_icon.slint";
import { GeneratedPasswordRow, GeneratedPasswordItem } from "generated_password_row.slint";

export { GeneratedPasswordItem }

export component PasswordHistoryModal inherits Rectangle {
    in property <[GeneratedPasswordItem]> historial: [];

    callback copiar-clave(string);
    callback limpiar-historial();
    callback cerrar();

    width: 100%;
    height: 100%;
    background: #000000B0;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    Rectangle {
        width: Math.min(640px, root.width - 48px);
        height: Math.min(500px, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;
                spacing: 10px;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Historial de Contraseñas Generadas";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 800;
                    }
                    Text {
                        text: "Registro en memoria volátil de las contraseñas generadas durante esta sesión.";
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    if root.historial.length > 0 : btn-clear := TouchArea {
                        width: 118px;
                        height: 32px;
                        mouse-cursor: pointer;
                        clicked => { root.limpiar-historial(); }

                        Rectangle {
                            background: btn-clear.has-hover ? Theme.danger.transparentize(80%) : Theme.background;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.danger;

                            Text {
                                text: "Limpiar historial";
                                color: Theme.danger;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn-close := TouchArea {
                        width: 32px;
                        height: 32px;
                        mouse-cursor: pointer;
                        clicked => { root.cerrar(); }

                        Rectangle {
                            background: btn-close.has-hover ? Theme.surface-hover : Theme.background;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;

                            AppIcon {
                                source: @image-url("../assets/icons/close.svg");
                                icon-size: 14px;
                                icon-color: Theme.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if root.historial.length == 0 : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 6px;

                Text {
                    text: "Aún no se han generado contraseñas en esta sesión";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }

            if root.historial.length > 0 : Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: hist-list.min-height;

                hist-list := VerticalLayout {
                    width: 100%;
                    spacing: 6px;
                    alignment: start;

                    for item in root.historial : GeneratedPasswordRow {
                        item: item;
                        copiar(c) => { root.copiar-clave(c); }
                    }
                }
            }
        }
    }
}
