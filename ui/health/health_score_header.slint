import { Theme } from "../theme.slint";
import { AppIcon } from "../components/widgets/app_icon.slint";

export component HealthScoreHeader inherits Rectangle {
    in property <int> puntuacion: 100;
    in property <int> total-alertas: 0;
    callback cerrar();

    width: 100%;
    height: 76px;
    background: Theme.background;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            // Indicador de Puntuación Global (0-100)
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 26px;
                    background: root.puntuacion >= 80 ? Theme.accent-primary.transparentize(82%) :
                                root.puntuacion >= 50 ? Theme.accent-amber.transparentize(82%) :
                                Theme.danger.transparentize(82%);
                    border-width: 2px;
                    border-color: root.puntuacion >= 80 ? Theme.accent-primary :
                                  root.puntuacion >= 50 ? Theme.accent-amber :
                                  Theme.danger;

                    Text {
                        text: root.puntuacion + "%";
                        color: root.puntuacion >= 80 ? Theme.accent-primary :
                               root.puntuacion >= 50 ? Theme.accent-amber :
                               Theme.danger;
                        font-size: 14px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                Text {
                    text: "Salud y Auditoría de la Bóveda";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 800;
                }

                Text {
                    text: root.total-alertas == 0 ?
                        "Excelente: no se detectaron vulnerabilidades activas en tus contraseñas." :
                        root.total-alertas + " observaciones detectadas en tus credenciales activas.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            btn-close := TouchArea {
                width: 32px;
                height: 32px;
                mouse-cursor: pointer;
                clicked => { root.cerrar(); }

                Rectangle {
                    background: btn-close.has-hover ? Theme.surface-hover : Theme.surface;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border;

                    AppIcon {
                        source: @image-url("../assets/icons/close.svg");
                        icon-size: 14px;
                        icon-color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
