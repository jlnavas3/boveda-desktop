import { Theme } from "../theme.slint";
import { SearchBar } from "../components/search_bar.slint";
import { EntryItem, EntryOverview } from "../components/entry_item.slint";
import { EntryDetail, EntryDetailData } from "entry_detail.slint";
import { AlphabetIndex } from "../components/alphabet_index.slint";
import { FilterBar } from "../components/filter_bar.slint";
import { FilterPopover } from "../components/filter_popover.slint";
import { DropdownOption } from "../components/dropdown_filter.slint";
import { ContextMenu } from "../components/widgets/context_menu.slint";
import { AppIcon } from "../components/widgets/app_icon.slint";
import { GroupHeaderItem } from "../components/widgets/group_header_item.slint";
import { ListOverflowMenu } from "../components/widgets/list_overflow_menu.slint";
import { SelectionTopBar } from "../components/selection/selection_top_bar.slint";
import { SelectionBottomBar } from "../components/selection/selection_bottom_bar.slint";
import { BatchActionDialog } from "../components/selection/batch_action_dialog.slint";
import { MainSidebar, FilterItem } from "../components/sidebar/main_sidebar.slint";

export { FilterItem }

export component MainScreen inherits Rectangle {
    in property <[FilterItem]> tipos-filtro: [];
    in property <[FilterItem]> categorias-filtro: [];
    in property <[DropdownOption]> tipos-dropdown: [];
    in property <[DropdownOption]> categorias-dropdown: [];
    in property <[DropdownOption]> perfiles-filtro: [];
    in property <[DropdownOption]> etiquetas-filtro: [];

    in property <string> filtro-tipo-actual: "TODOS";
    in property <string> filtro-categoria-actual: "TODAS";
    in property <string> filtro-perfil-actual: "TODOS";
    in property <string> filtro-etiqueta-actual: "TODAS";
    in property <string> entrada-seleccionada-id: "";
    
    in property <[EntryOverview]> lista-entradas: [];
    in property <EntryDetailData> detalle-actual;
    in property <string> texto-notificacion: "";

    in property <bool> mostrar-ola-niagara: true;
    in property <bool> efecto-ola-niagara: true;
    in property <length> amplitud-ola-niagara: 24px;
    in property <bool> incluir-enie-niagara: true;

    in property <bool> solo-favoritos: false;
    in property <string> orden-actual: "NOMBRE_AZ";

    // Contadores reactivos de auditoría y herramientas para MainSidebar
    in property <int> conteo-favoritos: 0;
    in property <int> conteo-salud-alertas: 0;
    in property <int> conteo-duplicados: 0;
    in property <int> conteo-papelera: 0;
    in property <int> conteo-perfiles: 0;
    in property <int> conteo-categorias: 0;
    in property <int> total-entradas-boveda: 0;
    in property <int> conteo-entradas-filtradas: 0;
    in property <int> conteo-totp: 0;
    in property <int> conteo-passkeys: 0;
    in property <int> conteo-titulos-sucios: 0;
    in property <int> conteo-historial-generador: 0;
    in property <string> perfil-argon2-nombre: "ESTÁNDAR";

    // Propiedades de selección múltiple / simple
    in property <int> conteo-seleccionadas: 0;
    in property <bool> todas-seleccionadas: false;
    in property <string> resumen-unificacion-lote: "";
    in-out property <string> modo-dialogo-lote: "";
    in-out property <string> texto-dialogo-lote: "";

    in-out property <bool> sidebar-colapsada: false;
    in-out property <length> ancho-sidebar: 230px;
    in-out property <length> ancho-lista: 360px;
    in-out property <length> lista-viewport-y: 0px;

    property <length> min-ancho-detalle: 340px;
    property <length> max-sidebar-dinamico: root.width > 640px ? Math.max(160px, Math.min(360px, root.width - 260px - root.min-ancho-detalle - 8px)) : 230px;
    property <length> ancho-sidebar-efectivo: root.sidebar-colapsada ? 64px : Math.clamp(root.ancho-sidebar, 160px, root.max-sidebar-dinamico);
    property <length> max-lista-dinamico: root.width > 640px ? Math.max(260px, Math.min(550px, root.width - root.ancho-sidebar-efectivo - root.min-ancho-detalle - 8px)) : 360px;
    property <length> ancho-lista-efectivo: Math.clamp(root.ancho-lista, 260px, root.max-lista-dinamico);

    callback seleccionar-tipo(string);
    callback seleccionar-categoria(string);
    callback seleccionar-perfil(string);
    callback seleccionar-etiqueta(string);
    callback seleccionar-entrada(string);

    property <int> menu-filtro-abierto: 0;
    callback buscar(string);
    callback bloquear-boveda();
    callback copiar-campo(string, string);
    callback cerrar-detalle();
    callback abrir-nueva-entrada();
    callback abrir-ajustes();
    callback editar-entrada(string);
    callback mover-papelera(string);
    callback restaurar-entrada(string);
    callback eliminar-definitivo(string);
    callback saltar-a-letra(string);
    callback alternar-favorito(string);
    callback alternar-anclado(string);
    callback copiar-totp(string);
    callback restaurar-password-historial(string, string);
    callback eliminar-password-historial(string, string);
    callback promover-passkey-secundaria(string, string);
    callback eliminar-passkey-secundaria(string, string);
    callback promover-totp-secundario(string, string);
    callback eliminar-totp-secundario(string, string);
    callback guardar-adjunto(string, string);

    // Callbacks de selección múltiple y acciones en lote
    callback alternar-seleccion-entrada(string);
    callback alternar-seleccion-grupo(string);
    callback cancelar-seleccion();
    callback alternar-seleccionar-todas();
    callback lote-favorito();
    callback lote-anclar();
    callback lote-salud();
    callback lote-exportar();
    callback lote-papelera();
    callback lote-restaurar();
    callback lote-eliminar-definitivo();
    callback preparar-unificacion-lote();
    callback confirmar-renombrar-lote(string);
    callback confirmar-categoria-lote(string);
    callback confirmar-unificar-lote(string);

    // Callbacks del menú de 3 puntos y agrupamiento
    callback alternar-grupo(string);
    callback alternar-solo-favoritos();
    callback normalizar-titulos();
    callback crear-nuevo-tipo(string);
    callback cambiar-orden(string);
    callback importar-bitwarden();
    callback importar-csv();
    callback fusionar-boveda();
    callback exportar-bvda();
    callback exportar-json();
    callback exportar-csv();
    callback navegar-apariencia();
    callback abrir-ayuda();
    callback abrir-salud();
    callback abrir-duplicados();
    callback abrir-escaner-qr();
    callback abrir-gestor-categorias();
    callback abrir-gestor-perfiles();
    callback abrir-generador-sidebar();
    callback abrir-historial-claves();
    callback vaciar-papelera();

    property <string> menu-contextual-id: "";
    property <bool> menu-contextual-favorito: false;
    property <bool> menu-contextual-anclado: false;
    property <bool> menu-contextual-tiene-totp: false;
    property <bool> menu-contextual-tiene-password: false;
    property <bool> menu-contextual-tiene-usuario: false;
    property <bool> menu-contextual-seleccionada-lote: false;
    property <string> menu-contextual-subtitulo: "";
    property <length> menu-contextual-pos-x: 0px;
    property <length> menu-contextual-pos-y: 0px;

    pure function calcular-posicion-menu-contextual(
        sidebar-ancho: length,
        sidebar-colapsada: bool,
        flickable-offset-y: length,
        fila-offset-y: length,
        scroll-y: length,
        click-x: length,
        click-y: length,
        ventana-ancho: length,
        ventana-alto: length
    ) -> { x: length, y: length } {
        // Offset de cabecera superior del panel central (Padding 12px + SearchBar 36px + Gap 10px + FilterBar 32px + Gap 10px + Conteo 18px + Gap 10px = 128px)
        let cabecera-panel-y = 128px;
        let base-x = (sidebar-colapsada ? 64px : sidebar-ancho) + 16px + click-x;
        let base-y = cabecera-panel-y + flickable-offset-y + fila-offset-y + scroll-y + click-y;
        return {
            x: Math.max(10px, Math.min(ventana-ancho - 220px, base-x)),
            y: Math.max(10px, Math.min(ventana-alto - 250px, base-y))
        };
    }

    menu-ctx := ContextMenu {
        x: root.menu-contextual-pos-x;
        y: root.menu-contextual-pos-y;
        es-favorito: root.menu-contextual-favorito;
        es-anclado: root.menu-contextual-anclado;
        tiene-totp: root.menu-contextual-tiene-totp;
        tiene-password: root.menu-contextual-tiene-password;
        tiene-usuario: root.menu-contextual-tiene-usuario;
        es-seleccionada-lote: root.menu-contextual-seleccionada-lote;

        alternar-seleccion => { root.alternar-seleccion-entrada(root.menu-contextual-id); }
        copiar-usuario => { root.copiar-campo(root.menu-contextual-subtitulo, "Usuario"); }
        copiar-password => { root.copiar-campo(root.menu-contextual-id, "Contraseña"); }
        copiar-totp => { root.copiar-totp(root.menu-contextual-id); }
        alternar-favorito => { root.alternar-favorito(root.menu-contextual-id); }
        alternar-anclado => { root.alternar-anclado(root.menu-contextual-id); }
        editar => { root.editar-entrada(root.menu-contextual-id); }
        eliminar => { root.mover-papelera(root.menu-contextual-id); }
    }

    overflow-menu := ListOverflowMenu {
        x: (root.sidebar-colapsada ? 64px : root.ancho-sidebar) + root.ancho-lista - 250px;
        y: 54px;
        solo-favoritos: root.solo-favoritos;
        orden-actual: root.orden-actual;
        filtro-tipo-actual: root.filtro-tipo-actual;

        crear-nuevo-tipo(t) => { root.crear-nuevo-tipo(t); }
        cambiar-orden(o) => { root.cambiar-orden(o); }
        cambiar-filtro-tipo(t) => { root.seleccionar-tipo(t); }
        alternar-solo-favoritos => { root.alternar-solo-favoritos(); }
        normalizar-titulos => { root.normalizar-titulos(); }
        importar-bitwarden => { root.importar-bitwarden(); }
        importar-csv => { root.importar-csv(); }
        fusionar-boveda => { root.fusionar-boveda(); }
        abrir-sincronizacion-p2p => { root.abrir-escaner-qr(); }
        exportar-bvda => { root.exportar-bvda(); }
        exportar-json => { root.exportar-json(); }
        exportar-csv => { root.exportar-csv(); }
        navegar-apariencia => { root.navegar-apariencia(); }
        navegar-ajustes => { root.abrir-ajustes(); }
        abrir-ayuda => { root.abrir-ayuda(); }
    }

    background: Theme.background;

    HorizontalLayout {
        // PANEL IZQUIERDO: Barra Lateral Completa y Modular (MainSidebar)
        MainSidebar {
            width: root.ancho-sidebar-efectivo;
            tipos-filtro: root.tipos-filtro;
            categorias-filtro: root.categorias-filtro;
            perfiles-filtro: root.perfiles-filtro;
            filtro-tipo-actual: root.filtro-tipo-actual;
            filtro-categoria-actual: root.filtro-categoria-actual;
            filtro-perfil-actual: root.filtro-perfil-actual;
            solo-favoritos: root.solo-favoritos;
            conteo-favoritos: root.conteo-favoritos;
            conteo-salud-alertas: root.conteo-salud-alertas;
            conteo-duplicados: root.conteo-duplicados;
            conteo-papelera: root.conteo-papelera;
            conteo-perfiles: root.conteo-perfiles;
            conteo-categorias: root.conteo-categorias;
            conteo-totp: root.conteo-totp;
            conteo-passkeys: root.conteo-passkeys;
            conteo-titulos-sucios: root.conteo-titulos-sucios;
            conteo-historial-generador: root.conteo-historial-generador;
            perfil-argon2-nombre: root.perfil-argon2-nombre;
            sidebar-colapsada <=> root.sidebar-colapsada;

            bloquear-boveda => { root.bloquear-boveda(); }
            abrir-nueva-entrada => { root.abrir-nueva-entrada(); }
            seleccionar-tipo(t) => { root.seleccionar-tipo(t); }
            seleccionar-categoria(c) => { root.seleccionar-categoria(c); }
            seleccionar-perfil(p) => { root.seleccionar-perfil(p); }
            alternar-solo-favoritos => { root.alternar-solo-favoritos(); }
            abrir-salud => { root.abrir-salud(); }
            abrir-duplicados => { root.abrir-duplicados(); }
            abrir-normalizador-titulos => { root.normalizar-titulos(); }
            abrir-gestor-categorias => { root.abrir-gestor-categorias(); }
            abrir-gestor-perfiles => { root.abrir-gestor-perfiles(); }
            abrir-generador => { root.abrir-generador-sidebar(); }
            abrir-escaner-qr => { root.abrir-escaner-qr(); }
            abrir-historial-claves => { root.abrir-historial-claves(); }
            vaciar-papelera => { root.vaciar-papelera(); }
            abrir-ajustes => { root.abrir-ajustes(); }
        }

        // SPLITTER 1 (Lateral <-> Lista)
        Rectangle {
            width: 4px;
            background: split-1.has-hover ? Theme.accent-primary : Theme.border;

            split-1 := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    if !root.sidebar-colapsada {
                        let limite-max = root.width > 640px ? Math.max(160px, Math.min(360px, root.width - root.ancho-lista-efectivo - root.min-ancho-detalle - 8px)) : 360px;
                        root.ancho-sidebar = Math.clamp(root.ancho-sidebar + (split-1.mouse-x - split-1.pressed-x), 160px, limite-max);
                    }
                }
            }
        }

        // PANEL CENTRAL: Lista Fluida de Entradas con Ola Niagara A-Z
        Rectangle {
            width: root.ancho-lista-efectivo;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                if root.conteo-seleccionadas > 0 : SelectionTopBar {
                    conteo-seleccionadas: root.conteo-seleccionadas;
                    todas-seleccionadas: root.todas-seleccionadas;
                    cancelar-seleccion => { root.cancelar-seleccion(); }
                    alternar-seleccionar-todas => { root.alternar-seleccionar-todas(); }
                }

                // Buscador en Tiempo Real + Botón Menú de 3 Puntos
                HorizontalLayout {
                    spacing: 8px;

                    SearchBar {
                        horizontal-stretch: 1;
                        search-changed(q) => { root.buscar(q); }
                        clear-clicked() => { root.buscar(""); }
                    }

                    btn-sync := TouchArea {
                        width: 36px;
                        height: 36px;
                        mouse-cursor: pointer;
                        clicked => { root.abrir-escaner-qr(); }

                        Rectangle {
                            background: btn-sync.has-hover ? Theme.surface-hover : Theme.surface;
                            border-radius: Theme.curvatura-esquinas > 0px ? Theme.curvatura-esquinas / 2 : 6px;
                            border-width: Theme.grosor-borde;
                            border-color: Theme.border;

                            AppIcon {
                                source: @image-url("../assets/icons/qr_code.svg");
                                icon-size: 18px;
                                icon-color: btn-sync.has-hover ? Theme.accent-primary : Theme.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn-overflow := TouchArea {
                        width: 36px;
                        height: 36px;
                        clicked => {
                            overflow-menu.show();
                        }

                        Rectangle {
                            background: btn-overflow.has-hover ? Theme.surface-hover : Theme.surface;
                            border-radius: Theme.curvatura-esquinas > 0px ? Theme.curvatura-esquinas / 2 : 6px;
                            border-width: Theme.grosor-borde;
                            border-color: Theme.border;

                            AppIcon {
                                source: @image-url("../assets/icons/more_vert.svg");
                                icon-size: 18px;
                                icon-color: btn-overflow.has-hover ? Theme.accent-primary : Theme.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Barra Superior de Filtros Rápidos (solo visible si existen opciones reales para filtrar)
                if root.tipos-dropdown.length > 1 || root.perfiles-filtro.length > 1 || root.categorias-dropdown.length > 1 || root.etiquetas-filtro.length > 1 || root.filtro-tipo-actual != "TODOS" || root.filtro-perfil-actual != "TODOS" || root.filtro-categoria-actual != "TODAS" || root.filtro-etiqueta-actual != "TODAS" : FilterBar {
                    filtro-tipo: root.filtro-tipo-actual;
                    filtro-perfil: root.filtro-perfil-actual;
                    filtro-categoria: root.filtro-categoria-actual;
                    filtro-etiqueta: root.filtro-etiqueta-actual;
                    opciones-tipos: root.tipos-dropdown;
                    opciones-perfiles: root.perfiles-filtro;
                    opciones-categorias: root.categorias-dropdown;
                    opciones-etiquetas: root.etiquetas-filtro;

                    seleccionar-tipo(t) => { root.seleccionar-tipo(t); }
                    seleccionar-perfil(p) => { root.seleccionar-perfil(p); }
                    seleccionar-categoria(c) => { root.seleccionar-categoria(c); }
                    seleccionar-etiqueta(e) => { root.seleccionar-etiqueta(e); }
                }

                // Resumen de Conteo
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    alignment: space-between;

                    Text {
                        text: (root.filtro-tipo-actual != "TODOS" || root.filtro-perfil-actual != "TODOS" || root.filtro-categoria-actual != "TODAS" || root.filtro-etiqueta-actual != "TODAS" || root.solo-favoritos || root.conteo-entradas-filtradas != root.total-entradas-boveda)
                            ? (root.conteo-entradas-filtradas + (root.conteo-entradas-filtradas == 1 ? " resultado encontrado" : " resultados encontrados"))
                            : (root.total-entradas-boveda + (root.total-entradas-boveda == 1 ? " entrada cifrada" : " entradas cifradas"));
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }

                // Lista de Entradas + Abecedario Lateral Niagara
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 4px;

                    if lista-entradas.length == 0 : VerticalLayout {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        height: 100%;
                        alignment: center;
                        spacing: 8px;

                        AppIcon {
                            source: @image-url("../assets/icons/search.svg");
                            icon-size: 32px;
                            icon-color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                        Text { text: "No se encontraron entradas"; color: Theme.text-secondary; font-size: 13px; horizontal-alignment: center; }
                    }

                    if lista-entradas.length > 0 : lista-flickable := Flickable {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        height: 100%;
                        content-width: self.width;
                        content-y <=> root.lista-viewport-y;
                        content-height: items-layout.min-height;

                        items-layout := VerticalLayout {
                            width: 100%;
                            alignment: start;
                            spacing: 0px;

                            for entrada in lista-entradas : fila := VerticalLayout {
                                padding-bottom: (entrada.es_cabecera_grupo && entrada.grupo_expandido) || (entrada.es_hijo_grupo && !entrada.es_ultimo_hijo_grupo) ? 0px : 6px;

                                if entrada.es_cabecera_grupo : GroupHeaderItem {
                                    titulo: entrada.titulo;
                                    conteo: entrada.grupo_conteo;
                                    expandido: entrada.grupo_expandido;
                                    seleccionado: entrada.id == entrada-seleccionada-id;
                                    seleccionado-lote: entrada.seleccionada_lote;
                                    modo-seleccion: root.conteo-seleccionadas > 0;
                                    alternar => {
                                        root.alternar-grupo(entrada.clave_grupo);
                                        root.seleccionar-entrada(entrada.id);
                                    }
                                    alternar-seleccion-grupo => {
                                        root.alternar-seleccion-grupo(entrada.clave_grupo);
                                    }
                                }
                                if !entrada.es_cabecera_grupo : EntryItem {
                                    entrada: entrada;
                                    seleccionado: entrada.id == entrada-seleccionada-id;
                                    modo-seleccion: root.conteo-seleccionadas > 0;
                                    clicked => { root.seleccionar-entrada(entrada.id); }
                                    alternar-seleccion-lote => { root.alternar-seleccion-entrada(entrada.id); }
                                    abrir-menu-contextual(id, mx, my) => {
                                        root.menu-contextual-id = id;
                                        root.menu-contextual-favorito = entrada.favorito;
                                        root.menu-contextual-anclado = entrada.anclado;
                                        root.menu-contextual-tiene-totp = entrada.tiene_totp;
                                        root.menu-contextual-tiene-password = entrada.tiene_password;
                                        root.menu-contextual-tiene-usuario = entrada.tiene_usuario;
                                        root.menu-contextual-seleccionada-lote = entrada.seleccionada_lote;
                                        root.menu-contextual-subtitulo = entrada.subtitulo;

                                        let coords = root.calcular-posicion-menu-contextual(
                                            root.ancho-sidebar,
                                            root.sidebar-colapsada,
                                            lista-flickable.y,
                                            fila.y,
                                            root.lista-viewport-y,
                                            mx,
                                            my,
                                            root.width,
                                            root.height
                                        );
                                        root.menu-contextual-pos-x = coords.x;
                                        root.menu-contextual-pos-y = coords.y;
                                        menu-ctx.show();
                                    }
                                }
                            }
                        }
                    }

                    // Franja A-Z Niagara
                    if root.mostrar-ola-niagara && Theme.niagara-mostrar && lista-entradas.length > 5 : AlphabetIndex {
                        incluir-enie: root.incluir-enie-niagara && Theme.niagara-incluir-enie;
                        efecto-ola: root.efecto-ola-niagara;
                        amplitud-ola: Theme.niagara-amplitud * 1px;
                        radio-ola: Theme.niagara-alcance * 1px;
                        escala-letras: Theme.niagara-escala-letras;
                        mostrar-circulo: Theme.niagara-mostrar-circulo;
                        diametro-circulo: Theme.niagara-diametro-circulo * 1px;
                        desplazamiento-circulo: Theme.niagara-desplazamiento-circulo * 1px;
                        opacidad-inactivas: Theme.niagara-opacidad-inactivas;
                        ancho-tactil: Theme.niagara-ancho-tactil * 1px;
                        letra-seleccionada(l) => { root.saltar-a-letra(l); }
                    }
                }

                if root.conteo-seleccionadas > 0 : SelectionBottomBar {
                    conteo-seleccionadas: root.conteo-seleccionadas;
                    en-papelera: root.filtro-tipo-actual == "PAPELERA";
                    lote-favorito => { root.lote-favorito(); }
                    lote-anclar => { root.lote-anclar(); }
                    lote-renombrar => {
                        root.texto-dialogo-lote = "";
                        root.modo-dialogo-lote = "renombrar";
                    }
                    lote-categorias => {
                        root.modo-dialogo-lote = "categorias";
                    }
                    lote-unificar => {
                        root.preparar-unificacion-lote();
                        root.modo-dialogo-lote = "unificar";
                    }
                    lote-salud => { root.lote-salud(); }
                    lote-exportar => { root.lote-exportar(); }
                    lote-papelera => { root.lote-papelera(); }
                    lote-restaurar => { root.lote-restaurar(); }
                    lote-eliminar-definitivo => { root.lote-eliminar-definitivo(); }
                }
            }
        }

        // SPLITTER 2 (Lista <-> Detalle)
        Rectangle {
            width: 4px;
            background: split-2.has-hover ? Theme.accent-primary : Theme.border;

            split-2 := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    root.ancho-lista = Math.clamp(root.ancho-lista + (split-2.mouse-x - split-2.pressed-x), 260px, root.max-lista-dinamico);
                }
            }
        }

        // PANEL DERECHO: Detalle Completo de la Entrada Seleccionada
        Rectangle {
            horizontal-stretch: 1;
            min-width: root.min-ancho-detalle;
            background: Theme.surface;
            clip: true;

            VerticalLayout {
                if texto-notificacion != "" : Rectangle {
                    height: 36px;
                    background: Theme.accent-primary.transparentize(85%);
                    border-width: 1px;
                    border-color: Theme.accent-primary;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text { text: "✓"; color: Theme.accent-primary; font-weight: 800; vertical-alignment: center; }
                        Text { text: texto-notificacion; color: Theme.accent-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    }
                }

                EntryDetail {
                    entrada: detalle-actual;
                    copiar-campo(v, n) => { root.copiar-campo(v, n); }
                    editar => { root.editar-entrada(detalle-actual.id); }
                    mover-papelera => { root.mover-papelera(detalle-actual.id); }
                    restaurar => { root.restaurar-entrada(detalle-actual.id); }
                    eliminar-definitivo => { root.eliminar-definitivo(detalle-actual.id); }
                    cerrar => { root.cerrar-detalle(); }
                    alternar-favorito => { root.alternar-favorito(detalle-actual.id); }
                    alternar-anclado => { root.alternar-anclado(detalle-actual.id); }
                    filtrar-etiqueta(tag) => { root.seleccionar-etiqueta(tag); }
                    restaurar-password-historial(pw) => { root.restaurar-password-historial(detalle-actual.id, pw); }
                    eliminar-password-historial(pw) => { root.eliminar-password-historial(detalle-actual.id, pw); }
                    promover-passkey-secundaria(cid) => { root.promover-passkey-secundaria(detalle-actual.id, cid); }
                    eliminar-passkey-secundaria(cid) => { root.eliminar-passkey-secundaria(detalle-actual.id, cid); }
                    promover-totp-secundario(tid) => { root.promover-totp-secundario(detalle-actual.id, tid); }
                    eliminar-totp-secundario(tid) => { root.eliminar-totp-secundario(detalle-actual.id, tid); }
                    guardar-adjunto(aid) => { root.guardar-adjunto(detalle-actual.id, aid); }
                }
            }
        }
    }

    if root.modo-dialogo-lote != "" : BatchActionDialog {
        width: 100%;
        height: 100%;
        modo <=> root.modo-dialogo-lote;
        valor-texto <=> root.texto-dialogo-lote;
        opciones-categorias: root.categorias-dropdown;
        resumen-unificacion: root.resumen-unificacion-lote;
        conteo-seleccionadas: root.conteo-seleccionadas;
        confirmar-renombrar(nuevo) => {
            root.modo-dialogo-lote = "";
            root.confirmar-renombrar-lote(nuevo);
        }
        confirmar-categoria(cat) => {
            root.modo-dialogo-lote = "";
            root.confirmar-categoria-lote(cat);
        }
        confirmar-unificar(titulo) => {
            root.modo-dialogo-lote = "";
            root.confirmar-unificar-lote(titulo);
        }
        cancelar => {
            root.modo-dialogo-lote = "";
        }
    }
}
