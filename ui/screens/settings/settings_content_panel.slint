import { Theme } from "../../theme.slint";
import { SettingsData } from "../../settings/settings_modal.slint";

// 1. Seguridad
import { SubSecurityTimers } from "subsections/sub_security_timers.slint";
import { SubSecurityKdf } from "subsections/sub_security_kdf.slint";
import { SubSecurityPassword } from "subsections/sub_security_password.slint";
import { SubSecurityAutodestruct } from "subsections/sub_security_autodestruct.slint";
import { SubSecurityCommonPasswords } from "subsections/sub_security_common_passwords.slint";

// 2. Apariencia (12 Sub-secciones)
import { SubAppearanceTheme } from "subsections/sub_appearance_theme.slint";
import { SubAppearanceTypography } from "subsections/sub_appearance_typography.slint";
import { SubAppearanceGeometry } from "subsections/sub_appearance_geometry.slint";
import { SubAppearanceSidebar } from "subsections/sub_appearance_sidebar.slint";
import { SubAppearanceListDesign } from "subsections/sub_appearance_list_design.slint";
import { SubAppearanceNiagara } from "subsections/sub_appearance_niagara.slint";
import { SubAppearanceFormats } from "subsections/sub_appearance_formats.slint";
import { SubAppearanceTemplates } from "subsections/sub_appearance_templates.slint";
import { SubAppearanceIndicators } from "subsections/sub_appearance_indicators.slint";
import { SubAppearanceIdentity } from "subsections/sub_appearance_identity.slint";
import { SubAppearanceNotices } from "subsections/sub_appearance_notices.slint";
import { SubAppearanceTransitions } from "subsections/sub_appearance_transitions.slint";

// 3. Lista de cuentas (6 Sub-secciones)
import { SubAccountsOverview } from "subsections/sub_accounts_overview.slint";
import { SubListOrder } from "subsections/sub_list_order.slint";
import { SubListPrivacy } from "subsections/sub_list_privacy.slint";
import { SubToolsAudit } from "subsections/sub_tools_audit.slint";
import { SubAccountsTrash } from "subsections/sub_accounts_trash.slint";

// 4. Herramientas (5 Sub-secciones)
import { SubToolsGenerator } from "subsections/sub_tools_generator.slint";
import { SubToolsTotpParams } from "subsections/sub_tools_totp_params.slint";
import { SubToolsKeyHistory } from "subsections/sub_tools_key_history.slint";
import { SubSystemServices, PortRuleItem, PortRuleRow } from "subsections/sub_system_services.slint";
import { SubSystemSubdomains, SubdomainRuleItem, SubdomainRuleRow } from "subsections/sub_system_subdomains.slint";

// 5. Copias y datos (4 Sub-secciones)
import { SubBackupsExport } from "subsections/sub_backups_export.slint";
import { SubBackupsImport } from "subsections/sub_backups_import.slint";
import { SubBackupsMerge } from "subsections/sub_backups_merge.slint";
import { SubBackupsKit } from "subsections/sub_backups_kit.slint";

// 6. Sistema (4 Sub-secciones)
import { SubSystemDiagnostics } from "subsections/sub_system_diagnostics.slint";
import { SubSystemAbout } from "subsections/sub_system_about.slint";

export component SettingsContentPanel inherits Rectangle {
    in-out property <SettingsData> datos;
    in property <int> subseccion-activa: 1;
    in property <bool> cambiando-clave: false;

    in property <[PortRuleRow]> filas-puertos: [];
    in property <[SubdomainRuleRow]> filas-subdominios: [];

    in property <string> hex-usuario: "#2563EB";
    in property <string> hex-password: "#EAB308";
    in property <string> hex-totp: "#F97316";
    in property <string> hex-passkey: "#8B5CF6";
    in property <string> hex-url: "#06B6D4";
    in property <string> hex-app: "#16A34A";

    callback restaurar-campo(string);
    callback restaurar-seccion(string);
    callback cambiar-clave-maestra(string, string, string);
    callback exportar-json();
    callback exportar-csv();
    callback importar-bitwarden();
    callback importar-csv();
    callback fusionar-boveda();
    callback abrir-generador();
    callback auditoria-salud();
    callback alternar-biometria(bool);
    callback agregar-puerto(string, string);
    callback eliminar-puerto(string);
    callback agregar-subdominio(string);
    callback eliminar-subdominio(string);
    callback reportar-ancho-chips(float);
    callback abrir-selector-color(string);

    horizontal-stretch: 1;
    background: Theme.background;

    changed width => {
        if self.width > 50px {
            root.reportar-ancho-chips(self.width / 1px);
        }
    }

    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: content-layout.min-height;

        content-layout := VerticalLayout {
            width: 100%;
            padding: 24px;
            spacing: 16px;
            alignment: start;

            // 1. SEGURIDAD (5 Sub-secciones: 1..5)
            if root.subseccion-activa == 1 : SubSecurityTimers {
                autobloqueo-segundos <=> root.datos.autobloqueo_segundos;
                portapapeles-segundos <=> root.datos.portapapeles_segundos;
                restaurar-todo => { root.restaurar-seccion("seguridad_temporizadores"); }
                restaurar-autobloqueo => { root.restaurar-campo("autobloqueo"); }
                restaurar-portapapeles => { root.restaurar-campo("portapapeles"); }
            }

            if root.subseccion-activa == 2 : SubSecurityKdf {
                perfil-argon2 <=> root.datos.perfil_argon2;
                restaurar-todo => { root.restaurar-seccion("seguridad_kdf"); }
                restaurar-perfil => { root.restaurar-campo("argon2"); }
            }

            if root.subseccion-activa == 3 : SubSecurityPassword {
                cambiando-clave: root.cambiando-clave;
                cambiar-clave(act, nva, conf) => { root.cambiar-clave-maestra(act, nva, conf); }
            }

            if root.subseccion-activa == 4 : SubSecurityAutodestruct {
                autodestruccion-intentos <=> root.datos.autodestruccion_intentos;
                biometria-activa <=> root.datos.biometria_activa;
                restaurar-todo => { root.restaurar-seccion("seguridad_autodestruccion"); }
                restaurar-autodestruccion => { root.restaurar-campo("autodestruccion"); }
                alternar-biometria(act) => { root.alternar-biometria(act); }
            }

            if root.subseccion-activa == 5 : SubSecurityCommonPasswords {
                restaurar-todo => { root.restaurar-seccion("seguridad_comunes"); }
            }

            // 2. APARIENCIA (12 Sub-secciones: 101..112)
            if root.subseccion-activa == 101 : SubAppearanceTheme {
                modo-tema <=> root.datos.modo_tema;
                restaurar-todo => { root.restaurar-seccion("apariencia_tema"); }
                restaurar-tema => { root.restaurar-campo("modo_tema"); }
            }

            if root.subseccion-activa == 102 : SubAppearanceTypography {
                restaurar-todo => { root.restaurar-seccion("apariencia_tipografia"); }
            }

            if root.subseccion-activa == 103 : SubAppearanceGeometry {
                restaurar-todo => { root.restaurar-seccion("apariencia_geometria"); }
            }

            if root.subseccion-activa == 104 : SubAppearanceSidebar {
                restaurar-todo => { root.restaurar-seccion("apariencia_menu_lateral"); }
            }

            if root.subseccion-activa == 105 : SubAppearanceListDesign {
                criterio-ordenacion <=> root.datos.criterio_ordenacion;
                fijar-anclados-arriba <=> root.datos.fijar_anclados_arriba;
                restaurar-todo => { root.restaurar-seccion("apariencia_diseno_lista"); }
            }

            if root.subseccion-activa == 106 : SubAppearanceNiagara {
                ancho-disponible: root.width;
                altura-disponible: root.height;
                mostrar-ola-niagara <=> root.datos.mostrar_ola_niagara;
                incluir-enie-niagara <=> root.datos.incluir_enie_niagara;
                restaurar-todo => { root.restaurar-seccion("apariencia_niagara"); }
            }

            if root.subseccion-activa == 107 : SubAppearanceFormats {
                restaurar-todo => { root.restaurar-seccion("apariencia_formatos"); }
            }

            if root.subseccion-activa == 108 : SubAppearanceTemplates {
                restaurar-todo => { root.restaurar-seccion("apariencia_plantillas"); }
            }

            if root.subseccion-activa == 109 : SubAppearanceIndicators {
                hex-usuario: root.hex-usuario;
                hex-password: root.hex-password;
                hex-totp: root.hex-totp;
                hex-passkey: root.hex-passkey;
                hex-url: root.hex-url;
                hex-app: root.hex-app;
                restaurar-todo => { root.restaurar-seccion("apariencia_indicadores"); }
                restaurar-estilo => { root.restaurar-campo("indicadores_estilo"); }
                restaurar-calibracion => { root.restaurar-campo("indicadores_calibracion"); }
                restaurar-colores => { root.restaurar-campo("indicadores_colores"); }
                abrir-selector-color(c) => { root.abrir-selector-color(c); }
            }

            if root.subseccion-activa == 110 : SubAppearanceIdentity {
                nombre-boveda <=> root.datos.nombre_boveda;
                restaurar-todo => { root.restaurar-seccion("apariencia_identidad"); }
                restaurar-nombre => { root.restaurar-campo("nombre_boveda"); }
            }

            if root.subseccion-activa == 111 : SubAppearanceNotices {
                restaurar-todo => { root.restaurar-seccion("apariencia_avisos"); }
            }

            if root.subseccion-activa == 112 : SubAppearanceTransitions {
                restaurar-todo => { root.restaurar-seccion("apariencia_transiciones"); }
            }

            // 3. LISTA DE CUENTAS (6 Sub-secciones: 201..206)
            if root.subseccion-activa == 201 : SubAccountsOverview {
            }

            if root.subseccion-activa == 202 : SubListOrder {
                criterio-ordenacion <=> root.datos.criterio_ordenacion;
                fijar-anclados-arriba <=> root.datos.fijar_anclados_arriba;
                restaurar-todo => { root.restaurar-seccion("lista_orden"); }
                restaurar-orden => { root.restaurar-campo("criterio_ordenacion"); }
                restaurar-anclados => { root.restaurar-campo("fijar_anclados"); }
            }

            if root.subseccion-activa == 203 : SubListPrivacy {
                ocultar-usuario <=> root.datos.ocultar_usuario;
                ocultar-contrasena <=> root.datos.ocultar_contrasena;
                ocultar-notas <=> root.datos.ocultar_notas;
                restaurar-todo => { root.restaurar-seccion("lista_privacidad"); }
                restaurar-privacidad => { root.restaurar-campo("privacidad_campos"); }
            }

            if root.subseccion-activa == 204 : SubToolsAudit {
                auditoria-salud => { root.auditoria-salud(); }
            }

            if root.subseccion-activa == 205 : SubAccountsTrash {
                vaciar-papelera => {}
            }

            if root.subseccion-activa == 206 : SubAppearanceTemplates {
                restaurar-todo => { root.restaurar-seccion("categorias_cuentas"); }
            }

            // 4. HERRAMIENTAS (5 Sub-secciones: 301..305)
            if root.subseccion-activa == 301 : SubToolsGenerator {
                abrir-generador => { root.abrir-generador(); }
            }

            if root.subseccion-activa == 302 : SubToolsTotpParams {
                restaurar-todo => { root.restaurar-seccion("herramientas_totp"); }
            }

            if root.subseccion-activa == 303 : SubToolsKeyHistory {
                restaurar-todo => { root.restaurar-seccion("herramientas_historial"); }
            }

            if root.subseccion-activa == 304 : SubSystemServices {
                puertos-homelab <=> root.datos.puertos_homelab;
                filas-puertos: root.filas-puertos;
                restaurar-todo => { root.restaurar-seccion("sistema_servicios"); }
                restaurar-puertos => { root.restaurar-campo("puertos_homelab"); }
                agregar-puerto(p, n) => { root.agregar-puerto(p, n); }
                eliminar-puerto(id) => { root.eliminar-puerto(id); }
            }

            if root.subseccion-activa == 305 : SubSystemSubdomains {
                prefijos-subdominios <=> root.datos.prefijos_subdominios;
                filas-subdominios: root.filas-subdominios;
                restaurar-todo => { root.restaurar-seccion("sistema_subdominios"); }
                restaurar-subdominios => { root.restaurar-campo("prefijos_subdominios"); }
                agregar-subdominio(s) => { root.agregar-subdominio(s); }
                eliminar-subdominio(id) => { root.eliminar-subdominio(id); }
            }

            // 5. COPIAS Y DATOS (4 Sub-secciones: 401..404)
            if root.subseccion-activa == 401 : SubBackupsExport {
                exportar-json => { root.exportar-json(); }
                exportar-csv => { root.exportar-csv(); }
            }

            if root.subseccion-activa == 402 : SubBackupsImport {
                importar-bitwarden => { root.importar-bitwarden(); }
                importar-csv => { root.importar-csv(); }
            }

            if root.subseccion-activa == 403 : SubBackupsMerge {
                fusionar-boveda => { root.fusionar-boveda(); }
            }

            if root.subseccion-activa == 404 : SubBackupsKit {
                generar-kit => { root.exportar-json(); }
            }

            // 6. SISTEMA (4 Sub-secciones: 501..504)
            if root.subseccion-activa == 501 : SubSystemServices {
                puertos-homelab <=> root.datos.puertos_homelab;
                filas-puertos: root.filas-puertos;
                restaurar-todo => { root.restaurar-seccion("sistema_servicios"); }
                restaurar-puertos => { root.restaurar-campo("puertos_homelab"); }
                agregar-puerto(p, n) => { root.agregar-puerto(p, n); }
                eliminar-puerto(id) => { root.eliminar-puerto(id); }
            }

            if root.subseccion-activa == 502 : SubSystemDiagnostics {
            }

            if root.subseccion-activa == 503 : SubSecurityAutodestruct {
                autodestruccion-intentos <=> root.datos.autodestruccion_intentos;
                biometria-activa <=> root.datos.biometria_activa;
                alternar-biometria(act) => { root.alternar-biometria(act); }
            }

            if root.subseccion-activa == 504 : SubSystemAbout {
            }
        }
    }
}
