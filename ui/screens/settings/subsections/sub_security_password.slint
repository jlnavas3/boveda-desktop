import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";

export component SubSecurityPassword inherits VerticalLayout {
    in property <bool> cambiando-clave: false;
    callback cambiar-clave(string, string, string);

    property <string> clave-actual: "";
    property <string> clave-nueva: "";
    property <string> clave-confirmar: "";

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Clave Maestra";
        descripcion: "Actualización de la contraseña nuclear de cifrado de la bóveda.";
    }

    SettingBlock {
        titulo: "Cambiar Contraseña Maestra de la Bóveda";
        descripcion: "Re-cifra todos los registros y cabecera binaria .bvda con una nueva clave derivada.";
        mostrar-restaurar: false;

        VerticalLayout {
            spacing: 12px;
            alignment: start;

            // Clave Actual
            VerticalLayout {
                spacing: 4px;
                Text { text: "Contraseña Maestra Actual"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                Rectangle {
                    width: 320px; height: 36px;
                    background: Theme.background;
                    border-radius: Theme.radius-sm;
                    border-width: 1px; border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        TextInput {
                            text <=> root.clave-actual;
                            color: Theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Clave Nueva
            VerticalLayout {
                spacing: 4px;
                Text { text: "Nueva Contraseña Maestra (Mínimo 8 caracteres)"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                Rectangle {
                    width: 320px; height: 36px;
                    background: Theme.background;
                    border-radius: Theme.radius-sm;
                    border-width: 1px; border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        TextInput {
                            text <=> root.clave-nueva;
                            color: Theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Confirmar Clave Nueva
            VerticalLayout {
                spacing: 4px;
                Text { text: "Confirmar Nueva Contraseña"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                Rectangle {
                    width: 320px; height: 36px;
                    background: Theme.background;
                    border-radius: Theme.radius-sm;
                    border-width: 1px; border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        TextInput {
                            text <=> root.clave-confirmar;
                            color: Theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Botón de Acción
            TouchArea {
                width: 180px; height: 36px;
                enabled: !root.cambiando-clave;
                clicked => {
                    root.cambiar-clave(root.clave-actual, root.clave-nueva, root.clave-confirmar);
                }

                Rectangle {
                    background: parent.has-hover ? Theme.accent-hover : Theme.accent-primary;
                    border-radius: Theme.radius-sm;

                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Text {
                            text: root.cambiando-clave ? "Cifrando..." : "✓ Actualizar Clave";
                            color: #000000;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
