import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";
import { AppIcon } from "../../../components/widgets/app_icon.slint";

export component SubAppearanceTemplates inherits VerticalLayout {
    callback restaurar-todo();

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Plantillas de Campos";
        descripcion: "Estructuras predefinidas y modelos personalizados para acelerar la creación de nuevas entradas.";
        restaurar-grupo => { root.restaurar-todo(); }
    }

    SettingBlock {
        titulo: "Plantillas Predeterminadas del Sistema";
        descripcion: "Campos automáticos sugeridos según la categoría de la cuenta.";
        restaurar => {}

        VerticalLayout {
            spacing: 8px;

            for p in [
                { nombre: "Credencial Web Estándar", desc: "Usuario, Clave Maestra, URL, Código 2FA TOTP", icono: "key" },
                { nombre: "Tarjeta Bancaria", desc: "Número PAN, Titular, Vencimiento, CVV/CVC, PIN", icono: "credit_card" },
                { nombre: "Servidor / Infraestructura", desc: "Dirección IP, Puerto, Usuario SSH, Clave Privada, Clave Pública", icono: "dns" },
                { nombre: "Red Wi-Fi", desc: "SSID, Tipo de Seguridad, Contraseña, IP Router", icono: "wifi" }
            ]: Rectangle {
                height: 48px;
                background: Theme.background;
                border-radius: Theme.radius-sm;
                border-width: Theme.grosor-borde;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 12px; alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px; alignment: start;
                        AppIcon {
                            source: @image-url("../../../assets/icons/folder.svg");
                            icon-size: 16px;
                            icon-color: Theme.accent-primary;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: p.nombre; font-size: 12px; font-weight: 600; color: Theme.text-primary; }
                            Text { text: p.desc; font-size: 10px; color: Theme.text-muted; }
                        }
                    }

                    Rectangle {
                        height: 22px;
                        background: Theme.surface-hover;
                        border-radius: Theme.radius-sm;
                        border-width: Theme.grosor-borde;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text { text: "Sistema"; color: Theme.text-secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
