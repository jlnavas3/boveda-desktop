import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";

export component SubBackupsExport inherits VerticalLayout {
    callback exportar-json();
    callback exportar-csv();

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Exportación Soberana";
        descripcion: "Descarga de tus registros en texto claro o estructurado para copias de seguridad.";
    }

    SettingBlock {
        titulo: "Exportar Copia en Formato Estándar";
        descripcion: "Genera archivos legibles desprotegidos para migración externa o respaldo personal.";
        mostrar-restaurar: false;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            TouchArea {
                width: 170px; height: 34px;
                clicked => { root.exportar-json(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: parent.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px; border-color: Theme.border;

                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "Exportar JSON (.json)"; font-size: 11px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                    }
                }
            }

            TouchArea {
                width: 170px; height: 34px;
                clicked => { root.exportar-csv(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: parent.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px; border-color: Theme.border;

                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "Exportar CSV (.csv)"; font-size: 11px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
