import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";

export component SubSystemDesktop inherits VerticalLayout {
    callback aumentar-zoom();
    callback reducir-zoom();
    callback restaurar-zoom();

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Opciones de Escritorio y Escalado";
        descripcion: "Adaptación automática a resoluciones HD (1280×720), Full HD (1920×1080) y 4K UHD (3840×2160) más control manual.";
    }

    SettingBlock {
        titulo: "Zoom de Interfaz Nativa";
        descripcion: "Ajusta la escala visual de toda la ventana (también disponible mediante Ctrl +, Ctrl - y Ctrl 0).";
        mostrar-restaurar: false;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            btn-menos := TouchArea {
                width: 110px;
                height: 32px;
                mouse-cursor: pointer;
                clicked => { root.reducir-zoom(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: btn-menos.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        text: "− Reducir Zoom";
                        color: Theme.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            btn-reset := TouchArea {
                width: 120px;
                height: 32px;
                mouse-cursor: pointer;
                clicked => { root.restaurar-zoom(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: btn-reset.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        text: "100% Automático";
                        color: Theme.accent-primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            btn-mas := TouchArea {
                width: 115px;
                height: 32px;
                mouse-cursor: pointer;
                clicked => { root.aumentar-zoom(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: btn-mas.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        text: "+ Aumentar Zoom";
                        color: Theme.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
