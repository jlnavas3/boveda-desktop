import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";

export component SubBackupsImport inherits VerticalLayout {
    callback importar-bitwarden();
    callback importar-csv();

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Importación e Interoperabilidad";
        descripcion: "Adhesión de datos procedentes de otros gestores con clasificación automática.";
    }

    SettingBlock {
        titulo: "Importar Archivo de Contraseñas";
        descripcion: "Lee y añade las entradas de un archivo externo preservando historiales y metadatos.";
        mostrar-restaurar: false;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            TouchArea {
                width: 190px; height: 34px;
                clicked => { root.importar-bitwarden(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: parent.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px; border-color: Theme.border;

                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "Importar Bitwarden JSON"; font-size: 11px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                    }
                }
            }

            TouchArea {
                width: 190px; height: 34px;
                clicked => { root.importar-csv(); }

                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: parent.has-hover ? Theme.surface-hover : Theme.background;
                    border-width: 1px; border-color: Theme.border;

                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "Importar Genérico CSV"; font-size: 11px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
