import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";
import { SettingSwitch } from "../../../components/widgets/setting_switch.slint";

export component SubSecurityCommonPasswords inherits VerticalLayout {
    callback restaurar-todo();

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Contraseñas Comunes";
        descripcion: "Protección proactiva contra combinaciones predecibles, diccionarios de filtraciones y patrones débiles.";
        restaurar-grupo => { root.restaurar-todo(); }
    }

    SettingSwitch {
        titulo: "Bloquear Lista Negra de Contraseñas Comunes";
        subtitulo: "Impide asignar contraseñas que coincidan con el top 100.000 más vulneradas del mundo.";
        checked: true;
    }

    SettingBlock {
        titulo: "Auditoría de Entropía y Salud";
        descripcion: "Evalúa en tiempo real las credenciales registradas con puntuación Zxcvbn y Shannon.";
        restaurar => {}

        VerticalLayout {
            spacing: 8px;

            Rectangle {
                height: 48px;
                background: Theme.background;
                border-radius: Theme.radius-sm;
                border-width: Theme.grosor-borde;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px; alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        Text { text: "🛡️"; font-size: 14px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "Umbral de Longitud Recomendada"; font-size: 12px; font-weight: 600; color: Theme.text-primary; }
                            Text { text: "Mínimo 8 caracteres exigidos según estándar NIST 800-63B"; font-size: 10px; color: Theme.text-muted; }
                        }
                    }

                    Rectangle {
                        height: 24px;
                        background: Theme.surface-hover;
                        border-radius: Theme.radius-sm;
                        border-width: Theme.grosor-borde;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text { text: "≥ 8 caracteres"; color: Theme.accent-primary; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
