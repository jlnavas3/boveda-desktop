import { Theme } from "../../../theme.slint";
import { SettingGroupHeader } from "../../../components/widgets/setting_group_header.slint";
import { SettingBlock } from "../../../components/widgets/setting_block.slint";
import { SettingSliderRow } from "../../../components/widgets/setting_slider_row.slint";
import { SettingSwitchRow } from "../../../components/widgets/setting_switch_row.slint";
import { AlphabetIndex } from "../../../components/alphabet_index.slint";

export component SubAppearanceNiagara inherits VerticalLayout {
    in-out property <bool> mostrar-ola-niagara: true;
    in-out property <bool> incluir-enie-niagara: true;
    in property <length> altura-disponible: 700px;

    callback restaurar-todo();
    callback restaurar-grupo-ola();
    callback restaurar-grupo-circulo();
    callback restaurar-grupo-tactil();
    callback restaurar-grupo-resaltado();

    property <string> letra-previsualizada: "";

    spacing: 12px;

    SettingGroupHeader {
        titulo: "Índice A-Z (Ola Niagara)";
        descripcion: "Barra alfabética lateral táctil con curvatura sinusoidal interactiva y cápsula amplificadora de letras.";
        restaurar-grupo => {
            Theme.niagara-mostrar = true;
            Theme.niagara-amplitud = 60.0;
            Theme.niagara-alcance = 160.0;
            Theme.niagara-escala-letras = 1.8;
            Theme.niagara-mostrar-circulo = true;
            Theme.niagara-diametro-circulo = 52.0;
            Theme.niagara-desplazamiento-circulo = -64.0;
            Theme.niagara-incluir-enie = true;
            Theme.niagara-ancho-tactil = 28.0;
            Theme.niagara-opacidad-inactivas = 0.7;
            Theme.niagara-resaltar-arrastrar = true;
            Theme.niagara-resaltar-primera = false;
            Theme.niagara-alinear-cresta = true;
            root.mostrar-ola-niagara = true;
            root.incluir-enie-niagara = true;
            root.restaurar-todo();
        }
    }

    // Switch Maestro: Activar o desactivar el Abecedario Niagara
    SettingBlock {
        titulo: "Activación General del Abecedario Niagara";
        descripcion: "Muestra u oculta la franja vertical A-Z interactiva en el margen derecho de la lista de cuentas.";
        mostrar-restaurar: false;

        VerticalLayout {
            spacing: 6px;

            SettingSwitchRow {
                titulo: "Mostrar franja alfabética lateral";
                subtitulo: "Permite navegación rápida y saltos instantáneos deslizando sobre el abecedario";
                checked: root.mostrar-ola-niagara && Theme.niagara-mostrar;
                toggled(val) => {
                    root.mostrar-ola-niagara = val;
                    Theme.niagara-mostrar = val;
                }
            }
        }
    }

    // Área Horizontal: Panel de Bloques en Cuadrícula (Izquierda) + Banco de Prueba Dinámico (Derecha)
    HorizontalLayout {
        spacing: 16px;
        alignment: start;

        // Contenedor de Ajustes: 2 Columnas de bloques que mantienen su altura normal (alignment: start)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 12px;

            // Fila 1 de Bloques: Efecto Ola (Izq) ⟷ Círculo en Cresta (Der)
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                // 1. Grupo: Efecto ola niagara
                SettingBlock {
                    horizontal-stretch: 1;
                    titulo: "Efecto ola niagara";
                    descripcion: "Curvatura dinámica y deflexión horizontal sinusoidal proyectada al arrastrar sobre las letras.";
                    restaurar => {
                        Theme.niagara-amplitud = 60.0;
                        Theme.niagara-alcance = 160.0;
                        Theme.niagara-escala-letras = 1.8;
                        root.restaurar-grupo-ola();
                    }

                    VerticalLayout {
                        spacing: 6px;

                        SettingSliderRow {
                            titulo: "Amplitud de la ola";
                            subtitulo: "Deflexión máxima horizontal";
                            sufijo: "px";
                            minimum: 15.0;
                            maximum: 120.0;
                            step: 2.0;
                            value: Theme.niagara-amplitud;
                            changed(val) => { Theme.niagara-amplitud = val; }
                        }

                        SettingSliderRow {
                            titulo: "Alcance vertical de la ola";
                            subtitulo: "Radio de dispersión de la curva";
                            sufijo: "px";
                            minimum: 60.0;
                            maximum: 300.0;
                            step: 5.0;
                            value: Theme.niagara-alcance;
                            changed(val) => { Theme.niagara-alcance = val; }
                        }

                        SettingSliderRow {
                            titulo: "Escala máxima de letras";
                            subtitulo: "Factor de aumento en la cresta";
                            sufijo: "x";
                            minimum: 1.0;
                            maximum: 3.0;
                            step: 0.1;
                            value: Theme.niagara-escala-letras;
                            changed(val) => { Theme.niagara-escala-letras = val; }
                        }
                    }
                }

                // 2. Grupo: Círculo en cresta
                SettingBlock {
                    horizontal-stretch: 1;
                    titulo: "Círculo en cresta";
                    descripcion: "Globo flotante proyectado hacia la izquierda que magnifica e ilumina la letra seleccionada.";
                    restaurar => {
                        Theme.niagara-mostrar-circulo = true;
                        Theme.niagara-diametro-circulo = 52.0;
                        Theme.niagara-desplazamiento-circulo = -64.0;
                        root.restaurar-grupo-circulo();
                    }

                    VerticalLayout {
                        spacing: 6px;

                        SettingSwitchRow {
                            titulo: "Mostrar el círculo en la cresta";
                            subtitulo: "Despliega la burbuja de la letra activa al deslizar el cursor o dedo";
                            checked: Theme.niagara-mostrar-circulo;
                            toggled(val) => { Theme.niagara-mostrar-circulo = val; }
                        }

                        SettingSliderRow {
                            titulo: "Diámetro de la cresta";
                            subtitulo: "Tamaño de la burbuja";
                            sufijo: "px";
                            minimum: 36.0;
                            maximum: 96.0;
                            step: 2.0;
                            value: Theme.niagara-diametro-circulo;
                            changed(val) => { Theme.niagara-diametro-circulo = val; }
                        }

                        SettingSliderRow {
                            titulo: "Desplazamiento horizontal";
                            subtitulo: "Separación lateral respecto a las letras";
                            sufijo: "px";
                            minimum: -120.0;
                            maximum: -30.0;
                            step: 2.0;
                            value: Theme.niagara-desplazamiento-circulo;
                            changed(val) => { Theme.niagara-desplazamiento-circulo = val; }
                        }
                    }
                }
            }

            // Fila 2 de Bloques: Respuesta Táctil (Izq) ⟷ Resaltado Alfabético (Der)
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                // 3. Grupo: Respuesta táctil
                SettingBlock {
                    horizontal-stretch: 1;
                    titulo: "Respuesta táctil";
                    descripcion: "Sensibilidad de agarre en el margen derecho y juego de caracteres alfabéticos habilitados.";
                    restaurar => {
                        Theme.niagara-incluir-enie = true;
                        Theme.niagara-ancho-tactil = 28.0;
                        Theme.niagara-opacidad-inactivas = 0.7;
                        root.incluir-enie-niagara = true;
                        root.restaurar-grupo-tactil();
                    }

                    VerticalLayout {
                        spacing: 6px;

                        SettingSwitchRow {
                            titulo: "Incluir Ñ en el abecedario";
                            subtitulo: "Incorpora la letra Ñ entre la N y la O según el estándar en español";
                            checked: Theme.niagara-incluir-enie;
                            toggled(val) => {
                                Theme.niagara-incluir-enie = val;
                                root.incluir-enie-niagara = val;
                            }
                        }

                        SettingSliderRow {
                            titulo: "Ancho de la zona táctil";
                            subtitulo: "Margen de captura para puntero o pantalla táctil";
                            sufijo: "px";
                            minimum: 16.0;
                            maximum: 60.0;
                            step: 2.0;
                            value: Theme.niagara-ancho-tactil;
                            changed(val) => { Theme.niagara-ancho-tactil = val; }
                        }

                        SettingSliderRow {
                            titulo: "Tono y luminosidad de las letras";
                            subtitulo: "Visibilidad de las letras en reposo";
                            sufijo: "%";
                            minimum: 20.0;
                            maximum: 100.0;
                            step: 5.0;
                            value: Theme.niagara-opacidad-inactivas * 100.0;
                            changed(val) => { Theme.niagara-opacidad-inactivas = val / 100.0; }
                        }
                    }
                }

                // 4. Grupo: Resaltado alfabético
                SettingBlock {
                    horizontal-stretch: 1;
                    titulo: "Resaltado alfabético";
                    descripcion: "Coordinación visual entre la barra alfabética y las entradas visibles de la bóveda.";
                    restaurar => {
                        Theme.niagara-resaltar-arrastrar = true;
                        Theme.niagara-resaltar-primera = false;
                        Theme.niagara-alinear-cresta = true;
                        root.restaurar-grupo-resaltado();
                    }

                    VerticalLayout {
                        spacing: 6px;

                        SettingSwitchRow {
                            titulo: "Resaltar cuentas al arrastrar";
                            subtitulo: "Acentúa visualmente los elementos que coinciden con la letra seleccionada";
                            checked: Theme.niagara-resaltar-arrastrar;
                            toggled(val) => { Theme.niagara-resaltar-arrastrar = val; }
                        }

                        SettingSwitchRow {
                            titulo: "Resaltar solo la primera cuenta";
                            subtitulo: "Enfoca únicamente el primer registro que empieza con la letra seleccionada";
                            checked: Theme.niagara-resaltar-primera;
                            toggled(val) => { Theme.niagara-resaltar-primera = val; }
                        }

                        SettingSwitchRow {
                            titulo: "Alinear con la cresta de la ola";
                            subtitulo: "Sincroniza el desplazamiento vertical con el ápice de la curvatura";
                            checked: Theme.niagara-alinear-cresta;
                            toggled(val) => { Theme.niagara-alinear-cresta = val; }
                        }
                    }
                }
            }
        }

        // Columna Derecha: Tarjeta de Vista Previa Interactiva con Altura Dinámica Calibrada Exacta
        Rectangle {
            width: 170px;
            // Descuenta exactamente: Padding sup (24px) + GroupHeader (~50px) + Gap (12px) + Switch Maestro (~84px) + Gap (16px) + Padding inf (24px) = 210px
            height: Math.max(480px, root.altura-disponible - 210px);
            background: Theme.surface;
            border-radius: Theme.curvatura-esquinas;
            border-width: Theme.grosor-borde;
            border-color: Theme.border;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Vista Previa en Vivo";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.accent-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.letra-previsualizada != "" ? "Letra: \{root.letra-previsualizada}" : "Desliza el cursor";
                    font-size: 10px;
                    color: root.letra-previsualizada != "" ? Theme.text-primary : Theme.text-secondary;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Zona interactiva que ocupa todo el alto vertical restante
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: false;

                    HorizontalLayout {
                        alignment: end;
                        padding-right: 4px;

                        if (root.mostrar-ola-niagara && Theme.niagara-mostrar) : AlphabetIndex {
                            incluir-enie: root.incluir-enie-niagara && Theme.niagara-incluir-enie;
                            efecto-ola: true;
                            amplitud-ola: Theme.niagara-amplitud * 1px;
                            radio-ola: Theme.niagara-alcance * 1px;
                            escala-letras: Theme.niagara-escala-letras;
                            mostrar-circulo: Theme.niagara-mostrar-circulo;
                            diametro-circulo: Theme.niagara-diametro-circulo * 1px;
                            desplazamiento-circulo: Theme.niagara-desplazamiento-circulo * 1px;
                            opacidad-inactivas: Theme.niagara-opacidad-inactivas;
                            ancho-tactil: Theme.niagara-ancho-tactil * 1px;
                            letra-seleccionada(l) => { root.letra-previsualizada = l; }
                        }

                        if !(root.mostrar-ola-niagara && Theme.niagara-mostrar) : VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "Franja Desactivada";
                                font-size: 10px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
