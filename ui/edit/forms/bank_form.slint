import { Theme } from "../../theme.slint";

export component BankForm inherits VerticalLayout {
    in-out property <string> entidad: "";
    in-out property <string> titular: "";
    in-out property <string> numero-cuenta: "";
    in-out property <string> swift-bic: "";

    spacing: 10px;

    // Entidad Bancaria
    VerticalLayout {
        spacing: 4px;
        Text { text: "Entidad Bancaria"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 36px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TextInput {
                    text <=> root.entidad;
                    color: Theme.text-primary; font-size: 12px;
                    vertical-alignment: center; single-line: true;
                }
            }
        }
    }

    // Titular
    VerticalLayout {
        spacing: 4px;
        Text { text: "Titular de la Cuenta"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 36px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TextInput {
                    text <=> root.titular;
                    color: Theme.text-primary; font-size: 12px;
                    vertical-alignment: center; single-line: true;
                }
            }
        }
    }

    // IBAN / Número de Cuenta
    VerticalLayout {
        spacing: 4px;
        Text { text: "IBAN o Número de Cuenta"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 36px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TextInput {
                    text <=> root.numero-cuenta;
                    color: Theme.text-primary; font-size: 12px; font-weight: 600;
                    vertical-alignment: center; single-line: true;
                }
            }
        }
    }

    // SWIFT / BIC
    VerticalLayout {
        spacing: 4px;
        Text { text: "Código SWIFT / BIC"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 36px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TextInput {
                    text <=> root.swift-bic;
                    color: Theme.text-primary; font-size: 12px;
                    vertical-alignment: center; single-line: true;
                }
            }
        }
    }
}
