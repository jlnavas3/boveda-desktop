import { Theme } from "../../theme.slint";

export component ServerForm inherits VerticalLayout {
    in-out property <string> host: "";
    in-out property <string> puerto: "22";
    in-out property <string> usuario: "";
    in-out property <string> password: "";
    in-out property <string> clave-publica: "";

    spacing: 10px;

    // Host y Puerto
    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 3; spacing: 4px;
            Text { text: "Host o Dirección IP"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
            Rectangle {
                height: 36px; background: Theme.background;
                border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    TextInput {
                        text <=> root.host;
                        color: Theme.text-primary; font-size: 12px;
                        vertical-alignment: center; single-line: true;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1; spacing: 4px;
            Text { text: "Puerto"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
            Rectangle {
                height: 36px; background: Theme.background;
                border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    TextInput {
                        text <=> root.puerto;
                        color: Theme.text-primary; font-size: 12px;
                        vertical-alignment: center; single-line: true;
                    }
                }
            }
        }
    }

    // Usuario SSH
    VerticalLayout {
        spacing: 4px;
        Text { text: "Usuario de Conexión (ej. root, debian)"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 36px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TextInput {
                    text <=> root.usuario;
                    color: Theme.text-primary; font-size: 12px;
                    vertical-alignment: center; single-line: true;
                }
            }
        }
    }

    // Clave Privada o Contraseña
    VerticalLayout {
        spacing: 4px;
        Text { text: "Contraseña o Clave Privada SSH"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 54px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding: 6px;
                TextInput {
                    text <=> root.password;
                    color: Theme.text-primary; font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Clave Pública SSH
    VerticalLayout {
        spacing: 4px;
        Text { text: "Clave Pública SSH (ssh-ed25519 / ssh-rsa)"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Rectangle {
            height: 46px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding: 6px;
                TextInput {
                    text <=> root.clave-publica;
                    color: Theme.text-primary; font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
