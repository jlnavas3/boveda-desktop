import { Theme } from "../../theme.slint";

export component TotpField inherits VerticalLayout {
    in-out property <string> totp-secreto: "";
    in-out property <string> totp-emisor: "";
    in-out property <int> totp-periodo: 30;
    in-out property <int> totp-digitos: 6;

    spacing: 6px;

    HorizontalLayout {
        alignment: space-between;
        Text { text: "Verificación en Dos Pasos (TOTP RFC 6238)"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Text { text: "Secreto Base32 / otpauth://"; color: Theme.text-muted; font-size: 10px; }
    }

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 2; spacing: 2px;
            Rectangle {
                height: 36px; background: Theme.background;
                border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    TextInput {
                        text <=> root.totp-secreto;
                        color: Theme.accent-primary; font-size: 12px;
                        vertical-alignment: center; single-line: true;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1; spacing: 2px;
            Rectangle {
                height: 36px; background: Theme.background;
                border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    TextInput {
                        text <=> root.totp-emisor;
                        color: Theme.text-primary; font-size: 12px;
                        vertical-alignment: center; single-line: true;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            for d in [6, 8]: TouchArea {
                width: 34px; height: 36px;
                clicked => { root.totp-digitos = d; }
                Rectangle {
                    background: root.totp-digitos == d ? Theme.accent-primary.transparentize(84%) : Theme.background;
                    border-width: 1px;
                    border-color: root.totp-digitos == d ? Theme.accent-primary : Theme.border;
                    border-radius: Theme.radius-sm;
                    Text {
                        text: "\{d}d";
                        color: root.totp-digitos == d ? Theme.accent-primary : Theme.text-secondary;
                        font-size: 11px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
            for p in [30, 60]: TouchArea {
                width: 36px; height: 36px;
                clicked => { root.totp-periodo = p; }
                Rectangle {
                    background: root.totp-periodo == p ? Theme.accent-primary.transparentize(84%) : Theme.background;
                    border-width: 1px;
                    border-color: root.totp-periodo == p ? Theme.accent-primary : Theme.border;
                    border-radius: Theme.radius-sm;
                    Text {
                        text: "\{p}s";
                        color: root.totp-periodo == p ? Theme.accent-primary : Theme.text-secondary;
                        font-size: 11px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
        }
    }
}
