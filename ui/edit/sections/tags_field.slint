import { Theme } from "../../theme.slint";

export component TagsField inherits VerticalLayout {
    in-out property <string> etiquetas: "";
    in-out property <string> fecha-caducidad: "";
    in-out property <string> paquetes-android: "";

    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;

        // Etiquetas
        VerticalLayout {
            horizontal-stretch: 2; spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Etiquetas"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
                Text { text: "Separadas por comas"; color: Theme.text-muted; font-size: 10px; }
            }
            Rectangle {
                height: 36px; background: Theme.background;
                border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    TextInput {
                        text <=> root.etiquetas;
                        color: Theme.text-primary; font-size: 11px;
                        vertical-alignment: center; single-line: true;
                    }
                }
            }
        }

        // Fecha de Caducidad + Presets
        VerticalLayout {
            horizontal-stretch: 2; spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Caducidad (AAAA-MM-DD)"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 4px;
                    for p in [
                        { label: "+30d", val: "+30d" },
                        { label: "+90d", val: "+90d" },
                        { label: "+1a", val: "+365d" },
                        { label: "✕", val: "" }
                    ] : TouchArea {
                        height: 18px;
                        width: 30px;
                        clicked => { root.fecha-caducidad = p.val; }
                        Rectangle {
                            background: parent.has-hover ? Theme.surface-hover : Theme.background;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                text: p.label;
                                color: Theme.accent-primary;
                                font-size: 9px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 36px; background: Theme.background;
                border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    TextInput {
                        text <=> root.fecha-caducidad;
                        color: Theme.text-primary; font-size: 11px;
                        vertical-alignment: center; single-line: true;
                    }
                }
            }
        }
    }

    // Apps vinculadas (Paquetes Android / Identificadores de App)
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            alignment: space-between;
            Text { text: "Aplicaciones Vinculadas (Paquetes Android / App IDs)"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
            Text { text: "ej. com.github.android (separados por comas)"; color: Theme.text-muted; font-size: 10px; }
        }
        Rectangle {
            height: 34px; background: Theme.background;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                TextInput {
                    text <=> root.paquetes-android;
                    color: Theme.text-primary; font-size: 11px;
                    vertical-alignment: center; single-line: true;
                }
            }
        }
    }
}
