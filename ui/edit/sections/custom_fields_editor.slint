import { Theme } from "../../theme.slint";

export component CustomFieldsEditor inherits VerticalLayout {
    in-out property <string> campos-personalizados: "";

    spacing: 6px;

    HorizontalLayout {
        alignment: space-between;
        Text { text: "Campos Personalizados (Formato: Nombre: Valor)"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; }
        Text { text: "* Prefijo con * para campo sensible oculto"; color: Theme.text-muted; font-size: 10px; }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for preset in [
            { label: "+ PIN", tpl: "*PIN: " },
            { label: "+ Pregunta seguridad", tpl: "*Pregunta de seguridad: " },
            { label: "+ Código recuperación", tpl: "*Código de recuperación: " },
            { label: "+ Licencia", tpl: "Clave de licencia: " },
            { label: "+ ID Cliente", tpl: "ID Cliente: " }
        ] : TouchArea {
            height: 22px;
            width: txt-p.preferred-width + 14px;
            clicked => {
                if (root.campos-personalizados == "") {
                    root.campos-personalizados = preset.tpl;
                } else {
                    root.campos-personalizados = root.campos-personalizados + "\n" + preset.tpl;
                }
            }
            Rectangle {
                background: parent.has-hover ? Theme.surface-hover : Theme.background;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;
                txt-p := Text {
                    text: preset.label;
                    color: Theme.accent-primary;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle {
        height: 64px;
        background: Theme.background;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-sm;

        HorizontalLayout {
            padding: 8px;
            TextInput {
                text <=> root.campos-personalizados;
                color: Theme.text-primary;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}
