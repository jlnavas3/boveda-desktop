import { Theme } from "../theme.slint";

export component SettingRow inherits Rectangle {
    in property <string> icono: "⚙";
    in property <string> titulo: "";
    in property <string> subtitulo: "";
    in property <string> valor: "";
    in property <bool> accionable: true;
    callback clicked();

    background: touch.has-hover && accionable ? Theme.surface-hover : Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 52px;

    touch := TouchArea {
        enabled: root.accionable;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 12px;
            alignment: center;

            // Icono del ajuste
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.radius-sm;
                background: Theme.background;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: root.icono;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Título y subtítulo
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.titulo;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: left;
                }

                if root.subtitulo != "" : Text {
                    text: root.subtitulo;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
            }

            // Valor actual o chevron
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                if root.valor != "" : Text {
                    text: root.valor;
                    color: Theme.accent-primary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if root.accionable : Text {
                    text: "›";
                    color: Theme.text-muted;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}
