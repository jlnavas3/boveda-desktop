import { Theme } from "../../theme.slint";
import { AppIcon } from "../widgets/app_icon.slint";

export struct PasswordHistoryItem {
    password: string,
    fecha: string,
}

export component PasswordHistoryRow inherits Rectangle {
    in property <PasswordHistoryItem> item;
    in-out property <bool> revelado: false;
    in-out property <bool> copiado: false;

    callback copiar(string);
    callback restaurar(string);
    callback eliminar(string);

    background: Theme.surface;
    border-width: Theme.grosor-borde;
    border-color: Theme.color-ind-password.transparentize(65%);
    border-radius: Theme.curvatura-esquinas;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4.5px;
        height: parent.height;
        background: Theme.color-ind-password;
    }

    VerticalLayout {
        width: 100%;
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.item.fecha != "" ? "Cambiada el " + root.item.fecha : "Contraseña anterior";
                color: Theme.text-secondary;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                alignment: end;

                // Revelar / Ocultar
                btn-ojo := TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.revelado = !root.revelado; }

                    Rectangle {
                        background: btn-ojo.has-hover ? Theme.surface-hover : Colors.transparent;
                        border-radius: Theme.radius-sm;
                        AppIcon {
                            source: root.revelado ? @image-url("../../assets/icons/visibility_off.svg") : @image-url("../../assets/icons/visibility.svg");
                            icon-size: 14px;
                            icon-color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Copiar
                btn-copiar := TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => {
                        root.copiado = true;
                        root.copiar(root.item.password);
                    }

                    Rectangle {
                        background: root.copiado ? Theme.accent-primary.transparentize(80%) : (btn-copiar.has-hover ? Theme.surface-hover : Colors.transparent);
                        border-radius: Theme.radius-sm;
                        AppIcon {
                            source: root.copiado ? @image-url("../../assets/icons/check.svg") : @image-url("../../assets/icons/copy.svg");
                            icon-size: 13px;
                            icon-color: root.copiado ? Theme.accent-primary : Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Restaurar como principal
                btn-restaurar := TouchArea {
                    width: 76px;
                    height: 24px;
                    clicked => { root.restaurar(root.item.password); }

                    Rectangle {
                        background: btn-restaurar.has-hover ? Theme.accent-primary.transparentize(82%) : Theme.background;
                        border-width: 1px;
                        border-color: btn-restaurar.has-hover ? Theme.accent-primary : Theme.border;
                        border-radius: Theme.radius-sm;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            padding-left: 6px;
                            padding-right: 6px;

                            AppIcon {
                                source: @image-url("../../assets/icons/restart.svg");
                                icon-size: 12px;
                                icon-color: Theme.accent-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Restaurar";
                                color: Theme.accent-primary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Eliminar del historial
                btn-eliminar := TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.eliminar(root.item.password); }

                    Rectangle {
                        background: btn-eliminar.has-hover ? Theme.danger.transparentize(80%) : Colors.transparent;
                        border-radius: Theme.radius-sm;
                        AppIcon {
                            source: @image-url("../../assets/icons/delete.svg");
                            icon-size: 13px;
                            icon-color: btn-eliminar.has-hover ? Theme.danger : Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        TextInput {
            text: root.revelado ? root.item.password : "••••••••••••••••";
            color: Theme.text-primary;
            font-size: 13px;
            font-family: "monospace";
            read-only: true;
            single-line: true;
        }
    }
}
