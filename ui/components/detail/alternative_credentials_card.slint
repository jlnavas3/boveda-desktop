import { Theme } from "../../theme.slint";
import { AppIcon } from "../widgets/app_icon.slint";
import { PasswordHistoryItem, PasswordHistoryRow } from "password_history_row.slint";
import { SecondaryPasskeyItem, SecondaryPasskeyRow } from "secondary_passkey_row.slint";
import { SecondaryTotpItem, SecondaryTotpRow } from "secondary_totp_row.slint";

export component AlternativeCredentialsCard inherits Rectangle {
    in property <[PasswordHistoryItem]> historial-passwords: [];
    in property <[SecondaryPasskeyItem]> passkeys-secundarias: [];
    in property <[SecondaryTotpItem]> totps-secundarios: [];

    in-out property <bool> expandido: false;

    callback copiar-campo(string, string);
    callback restaurar-password(string);
    callback eliminar-password(string);
    callback promover-passkey(string);
    callback eliminar-passkey(string);
    callback promover-totp(string);
    callback eliminar-totp(string);

    background: Theme.surface;
    border-width: Theme.grosor-borde;
    border-color: Theme.border;
    border-radius: Theme.curvatura-esquinas;
    clip: true;

    VerticalLayout {
        width: 100%;
        padding: 12px;
        spacing: 10px;

        // Cabecera colapsable
        cabecera := TouchArea {
            height: 28px;
            clicked => {
                root.expandido = !root.expandido;
            }

            HorizontalLayout {
                width: 100%;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 8px;
                    alignment: start;

                    AppIcon {
                        horizontal-stretch: 0;
                        source: @image-url("../../assets/icons/key.svg");
                        icon-size: 16px;
                        icon-color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: "Credenciales alternativas";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }

                // Badges de conteo resumido + Chevron
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    alignment: end;

                    if root.historial-passwords.length > 0 : Rectangle {
                        background: Theme.surface-hover;
                        border-radius: 6px;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.historial-passwords.length + (root.historial-passwords.length == 1 ? " clave" : " claves");
                                color: Theme.text-secondary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.passkeys-secundarias.length > 0 : Rectangle {
                        background: Theme.surface-hover;
                        border-radius: 6px;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.passkeys-secundarias.length + (root.passkeys-secundarias.length == 1 ? " llave" : " llaves");
                                color: Theme.text-secondary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.totps-secundarios.length > 0 : Rectangle {
                        background: Theme.surface-hover;
                        border-radius: 6px;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.totps-secundarios.length + " 2FA";
                                color: Theme.text-secondary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    AppIcon {
                        source: root.expandido ? @image-url("../../assets/icons/expand_less.svg") : @image-url("../../assets/icons/expand_more.svg");
                        icon-size: 16px;
                        icon-color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Cuerpo expandido con las 3 subsecciones
        if root.expandido : VerticalLayout {
            spacing: 10px;

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // Subsección 1: Contraseñas anteriores
            if root.historial-passwords.length > 0 : VerticalLayout {
                spacing: 6px;

                Text {
                    text: "CONTRASEÑAS ANTERIORES (" + root.historial-passwords.length + ")";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: left;
                }

                for item in root.historial-passwords : PasswordHistoryRow {
                    item: item;
                    copiar(pw) => { root.copiar-campo(pw, "Contraseña anterior"); }
                    restaurar(pw) => { root.restaurar-password(pw); }
                    eliminar(pw) => { root.eliminar-password(pw); }
                }
            }

            // Subsección 2: Llaves de acceso secundarias
            if root.passkeys-secundarias.length > 0 : VerticalLayout {
                spacing: 6px;

                Text {
                    text: "LLAVES DE ACCESO SECUNDARIAS (" + root.passkeys-secundarias.length + ")";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: left;
                }

                for pk in root.passkeys-secundarias : SecondaryPasskeyRow {
                    item: pk;
                    promover(cid) => { root.promover-passkey(cid); }
                    eliminar(cid) => { root.eliminar-passkey(cid); }
                }
            }

            // Subsección 3: Códigos 2FA secundarios
            if root.totps-secundarios.length > 0 : VerticalLayout {
                spacing: 6px;

                Text {
                    text: "CÓDIGOS 2FA SECUNDARIOS (" + root.totps-secundarios.length + ")";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: left;
                }

                for totp in root.totps-secundarios : SecondaryTotpRow {
                    item: totp;
                    copiar(cod) => { root.copiar-campo(cod, "Código 2FA"); }
                    promover(tid) => { root.promover-totp(tid); }
                    eliminar(tid) => { root.eliminar-totp(tid); }
                }
            }
        }
    }
}
