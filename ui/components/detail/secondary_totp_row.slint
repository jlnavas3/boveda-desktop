import { Theme } from "../../theme.slint";
import { AppIcon } from "../widgets/app_icon.slint";

export struct SecondaryTotpItem {
    id: string,
    emisor: string,
    codigo: string,
    restante: int,
}

export component SecondaryTotpRow inherits Rectangle {
    in property <SecondaryTotpItem> item;
    in-out property <bool> copiado: false;

    callback copiar(string);
    callback promover(string);
    callback eliminar(string);

    background: Theme.surface;
    border-width: Theme.grosor-borde;
    border-color: Theme.color-ind-totp.transparentize(65%);
    border-radius: Theme.curvatura-esquinas;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4.5px;
        height: parent.height;
        background: Theme.color-ind-totp;
    }

    VerticalLayout {
        width: 100%;
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.item.emisor != "" ? "2FA • " + root.item.emisor : "Código 2FA alternativo";
                color: Theme.text-secondary;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                alignment: end;

                // Copiar código TOTP
                btn-copiar := TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => {
                        root.copiado = true;
                        root.copiar(root.item.codigo);
                    }

                    Rectangle {
                        background: root.copiado ? Theme.accent-primary.transparentize(80%) : (btn-copiar.has-hover ? Theme.surface-hover : Colors.transparent);
                        border-radius: Theme.radius-sm;
                        AppIcon {
                            source: root.copiado ? @image-url("../../assets/icons/check.svg") : @image-url("../../assets/icons/copy.svg");
                            icon-size: 13px;
                            icon-color: root.copiado ? Theme.accent-primary : Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Establecer como 2FA principal
                btn-promover := TouchArea {
                    width: 76px;
                    height: 24px;
                    clicked => { root.promover(root.item.id); }

                    Rectangle {
                        background: btn-promover.has-hover ? Theme.accent-primary.transparentize(82%) : Theme.background;
                        border-width: 1px;
                        border-color: btn-promover.has-hover ? Theme.accent-primary : Theme.border;
                        border-radius: Theme.radius-sm;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            padding-left: 6px;
                            padding-right: 6px;

                            AppIcon {
                                source: @image-url("../../assets/icons/restart.svg");
                                icon-size: 12px;
                                icon-color: Theme.accent-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Principal";
                                color: Theme.accent-primary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Eliminar TOTP secundario
                btn-eliminar := TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.eliminar(root.item.id); }

                    Rectangle {
                        background: btn-eliminar.has-hover ? Theme.danger.transparentize(80%) : Colors.transparent;
                        border-radius: Theme.radius-sm;
                        AppIcon {
                            source: @image-url("../../assets/icons/delete.svg");
                            icon-size: 13px;
                            icon-color: btn-eliminar.has-hover ? Theme.danger : Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text {
                text: root.item.codigo != "" ? root.item.codigo : "Código inválido";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
                font-family: "monospace";
                vertical-alignment: center;
            }

            if root.item.restante > 0 : Rectangle {
                background: root.item.restante <= 5 ? Theme.danger.transparentize(82%) : Theme.color-ind-totp.transparentize(84%);
                border-radius: 6px;
                height: 20px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;

                    Text {
                        text: root.item.restante + "s";
                        color: root.item.restante <= 5 ? Theme.danger : Theme.color-ind-totp;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
