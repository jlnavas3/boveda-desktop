import { Theme } from "../theme.slint";
import { AppIcon } from "widgets/app_icon.slint";

export component SecretField inherits Rectangle {
    in property <string> etiqueta: "Campo";
    in property <string> valor: "";
    in property <bool> es-secreto: false;
    in property <bool> multi-linea: false;
    in property <color> color-indicador: Colors.transparent;
    
    in-out property <bool> revelado: false;
    in-out property <bool> copiado: false;
    
    callback copiar();

    background: Theme.surface;
    border-width: Theme.grosor-borde;
    border-color: (root.color-indicador != Colors.transparent) ? root.color-indicador.transparentize(65%) : Theme.border;
    border-radius: Theme.curvatura-esquinas;
    clip: true;

    // Franja vertical izquierda acentuada (4.5px) fiel a Android TarjetaDatoDetalle
    if root.color-indicador != Colors.transparent : Rectangle {
        x: 0px;
        y: 0px;
        width: 4.5px;
        height: parent.height;
        background: root.color-indicador;
    }

    VerticalLayout {
        width: 100%;
        padding-left: (root.color-indicador != Colors.transparent) ? 14px : 10px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;

        // Fila de Etiqueta y Acciones
        HorizontalLayout {
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: etiqueta;
                color: Theme.text-secondary;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 8px;
                alignment: end;

                if es-secreto : TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => {
                        revelado = !revelado;
                    }

                    Rectangle {
                        background: parent.has-hover ? Theme.surface-hover : Colors.transparent;
                        border-radius: Theme.radius-sm;
                        AppIcon {
                            source: revelado ? @image-url("../assets/icons/visibility_off.svg") : @image-url("../assets/icons/visibility.svg");
                            icon-size: 14px;
                            icon-color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                TouchArea {
                    width: 70px;
                    height: 24px;
                    clicked => {
                        copiado = true;
                        root.copiar();
                    }

                    Rectangle {
                        background: copiado ? Theme.accent-primary.transparentize(80%) : 
                                   (parent.has-hover ? Theme.surface-hover : Colors.transparent);
                        border-width: 1px;
                        border-color: copiado ? Theme.accent-primary : Theme.border;
                        border-radius: Theme.radius-sm;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;

                            AppIcon {
                                source: copiado ? @image-url("../assets/icons/check.svg") : @image-url("../assets/icons/copy.svg");
                                icon-size: 12px;
                                icon-color: copiado ? Theme.accent-primary : Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: copiado ? "Listo" : "Copiar";
                                font-size: 11px;
                                font-weight: 600;
                                color: copiado ? Theme.accent-primary : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Fila de Contenido
        if multi-linea : TextInput {
            text: valor;
            color: Theme.text-primary;
            font-size: 13px;
            read-only: true;
            wrap: word-wrap;
        }

        if !multi-linea : TextInput {
            text: (es-secreto && !revelado) ? "••••••••••••••••" : valor;
            color: Theme.text-primary;
            font-size: 14px;
            font-family: (es-secreto && !revelado) ? "monospace" : "default";
            read-only: true;
            single-line: true;
        }
    }
}
