import { Theme } from "../../theme.slint";

export component SettingToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> texto-activo: "✓ Habilitado";
    in property <string> texto-inactivo: "Deshabilitado";
    callback toggled(bool);

    width: 160px;
    height: 34px;
    border-radius: Theme.radius-sm;
    background: root.checked ? Theme.accent-primary.transparentize(85%) : Theme.background;
    border-width: 1px;
    border-color: root.checked ? Theme.accent-primary : Theme.border;

    Text {
        width: 100%;
        height: 100%;
        text: root.checked ? root.texto-activo : root.texto-inactivo;
        font-size: 11px;
        font-weight: 600;
        color: root.checked ? Theme.accent-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
