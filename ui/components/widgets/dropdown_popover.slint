import { Theme } from "../../theme.slint";
import { AppIcon } from "app_icon.slint";

export struct DropdownOption {
    id: string,
    nombre: string,
    icono: string,
    conteo: int,
}

export component DropdownPopover inherits PopupWindow {
    in property <string> titulo: "";
    in property <[DropdownOption]> opciones: [];
    in property <string> seleccion-id: "";
    callback seleccionar(string);

    close-policy: close-on-click;
    width: 220px;

    Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000.transparentize(50%);
        clip: true;

        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            if root.titulo != "" : HorizontalLayout {
                padding-left: 6px; padding-right: 6px;
                alignment: start;
                Text { text: root.titulo; color: Theme.text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            }

            if root.titulo != "" : Rectangle { height: 1px; background: Theme.border; }

            Flickable {
                content-height: opt-layout.min-height;
                max-height: 240px;

                opt-layout := VerticalLayout {
                    spacing: 2px;
                    for opt in root.opciones : TouchArea {
                        height: 30px;
                        clicked => {
                            root.seleccionar(opt.id);
                        }
                        Rectangle {
                            background: opt.id == root.seleccion-id ?
                                Theme.accent-primary.transparentize(85%) :
                                parent.has-hover ? Theme.surface-hover : transparent;
                            border-radius: Theme.radius-sm;

                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    if opt.id == "LOGIN" : AppIcon { source: @image-url("../../assets/icons/key.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "TARJETA" : AppIcon { source: @image-url("../../assets/icons/credit_card.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "CUENTA_BANCARIA" : AppIcon { source: @image-url("../../assets/icons/account_balance.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "SERVIDOR" : AppIcon { source: @image-url("../../assets/icons/computer.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "WIFI" : AppIcon { source: @image-url("../../assets/icons/wifi.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "WALLET" : AppIcon { source: @image-url("../../assets/icons/wallet.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "IDENTIDAD" : AppIcon { source: @image-url("../../assets/icons/badge.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "CONTACTO" : AppIcon { source: @image-url("../../assets/icons/person.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "NOTA" : AppIcon { source: @image-url("../../assets/icons/note.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "PAPELERA" : AppIcon { source: @image-url("../../assets/icons/delete.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    if opt.id == "TODOS" || opt.id == "TODAS" : AppIcon { source: @image-url("../../assets/icons/folder.svg"); icon-size: 13px; icon-color: Theme.text-secondary; vertical-alignment: center; }
                                    Text {
                                        text: opt.nombre;
                                        color: opt.id == root.seleccion-id ? Theme.accent-primary : Theme.text-primary;
                                        font-size: 11px;
                                        font-weight: opt.id == root.seleccion-id ? 700 : 500;
                                        vertical-alignment: center;
                                    }
                                }

                                if opt.conteo > 0 : Text {
                                    text: opt.conteo;
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
