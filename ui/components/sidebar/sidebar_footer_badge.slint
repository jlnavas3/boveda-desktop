import { Theme } from "../../theme.slint";
import { AppIcon } from "../widgets/app_icon.slint";

export component SidebarFooterBadge inherits Rectangle {
    in property <string> perfil-argon2: "ESTÁNDAR";
    in property <bool> colapsada: false;

    width: 100%;
    height: 26px;
    background: Theme.background;
    border-radius: Theme.radius-sm;
    border-width: Theme.menu-lateral-sin-bordes ? 0px : 1px;
    border-color: Theme.border;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        AppIcon {
            horizontal-stretch: 0;
            source: @image-url("../../assets/icons/shield.svg");
            icon-size: 13px;
            icon-color: Theme.accent-primary;
            vertical-alignment: center;
        }

        if !root.colapsada : Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: "Argon2id (" + root.perfil-argon2 + ") · AES-256";
            color: Theme.text-muted;
            font-size: 9px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
    }
}
