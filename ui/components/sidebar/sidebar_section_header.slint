import { Theme } from "../../theme.slint";
import { AppIcon } from "../widgets/app_icon.slint";

export component SidebarSectionHeader inherits HorizontalLayout {
    in property <string> titulo: "";
    in property <int> badge-conteo: 0;
    in property <bool> mostrar-accion: false;
    in property <string> texto-accion: "+";
    callback accion();

    width: 100%;
    height: 20px;
    padding-left: 4px;
    padding-right: 4px;
    spacing: 4px;

    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        text: root.titulo;
        color: Theme.text-muted;
        font-size: 10px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    if root.badge-conteo > 0 : Rectangle {
        horizontal-stretch: 0;
        height: 16px;
        border-radius: 8px;
        background: Theme.surface-hover;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            alignment: center;

            Text {
                text: root.badge-conteo;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    if root.mostrar-accion : btn-acc := TouchArea {
        horizontal-stretch: 0;
        width: 22px;
        height: 18px;
        mouse-cursor: pointer;
        clicked => { root.accion(); }

        Rectangle {
            background: btn-acc.has-hover ? Theme.surface-hover : Theme.background;
            border-radius: 4px;
            border-width: 1px;
            border-color: btn-acc.has-hover ? Theme.accent-primary : Theme.border;

            AppIcon {
                source: @image-url("../../assets/icons/add.svg");
                icon-size: 11px;
                icon-color: btn-acc.has-hover ? Theme.accent-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
