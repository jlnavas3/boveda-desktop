import { Theme } from "../theme.slint";
import { IndicatorLines } from "indicators/indicator_lines.slint";
import { IndicatorDots } from "indicators/indicator_dots.slint";
import { IndicatorIcons } from "indicators/indicator_icons.slint";
import { IndicatorStrip } from "indicators/indicator_strip.slint";
import { AppIcon } from "widgets/app_icon.slint";
import { SelectableAvatar } from "selection/selectable_avatar.slint";

export struct EntryOverview {
    id: string,
    titulo: string,
    subtitulo: string,
    tipo: string,
    favorito: bool,
    anclado: bool,
    categoria_id: string,
    tiene_usuario: bool,
    tiene_password: bool,
    tiene_totp: bool,
    tiene_passkey: bool,
    tiene_url: bool,
    tiene_app: bool,
    tiene_notas: bool,
    totp_codigo: string,
    totp_restante: int,
    servicio: string,
    es_cabecera_grupo: bool,
    clave_grupo: string,
    grupo_conteo: int,
    grupo_expandido: bool,
    es_hijo_grupo: bool,
    es_ultimo_hijo_grupo: bool,
    seleccionada_lote: bool,
    mostrar_chip_perfil: bool,
    nombre_perfil: string,
    color_perfil: color,
    es_documento_perfil: bool,
}

export component EntryItem inherits Rectangle {
    in property <EntryOverview> entrada;
    in property <bool> seleccionado: false;
    in property <bool> modo-seleccion: false;
    callback clicked();
    callback alternar-seleccion-lote();
    callback abrir-menu-contextual(string, length, length);

    background: entrada.seleccionada_lote ? Theme.accent-primary.transparentize(84%) :
                seleccionado ? Theme.surface-selected :
                touch.has-hover ? Theme.surface-hover :
                Theme.surface;
    border-top-left-radius: entrada.es_hijo_grupo ? 0px : Theme.radio-tarjetas;
    border-top-right-radius: entrada.es_hijo_grupo ? 0px : Theme.radio-tarjetas;
    border-bottom-left-radius: entrada.es_hijo_grupo ? (entrada.es_ultimo_hijo_grupo ? Theme.radio-tarjetas : 0px) : Theme.radio-tarjetas;
    border-bottom-right-radius: entrada.es_hijo_grupo ? (entrada.es_ultimo_hijo_grupo ? Theme.radio-tarjetas : 0px) : Theme.radio-tarjetas;
    border-width: 1px;
    border-color: (seleccionado || entrada.seleccionada_lote) ? Theme.accent-primary : (entrada.es_hijo_grupo ? Theme.accent-primary.transparentize(60%) : Theme.border);
    height: 64px;
    clip: true;

    // Divisor sutil interno de 1px único en la parte superior para ítems agrupados
    if entrada.es_hijo_grupo : Rectangle {
        y: 0px;
        x: 0px;
        width: root.width;
        height: 1px;
        background: Theme.border;
    }

    // Conector visual sutil para cuentas hijas agrupadas
    if entrada.es_hijo_grupo : Rectangle {
        x: 8px;
        y: 12px;
        width: 3px;
        height: root.height - 24px;
        background: Theme.accent-primary.transparentize(50%);
        border-radius: 1.5px;
    }

    // ESTILO 1: Líneas superiores en el borde superior
    if Theme.estilo-indicadores == "lineas" : IndicatorLines {
        y: 0px; width: 100%; height: 3px;
        tiene-usuario: root.entrada.tiene_usuario;
        tiene-password: root.entrada.tiene_password;
        tiene-totp: root.entrada.tiene_totp;
        tiene-passkey: root.entrada.tiene_passkey;
        tiene-url: root.entrada.tiene_url;
        tiene-app: root.entrada.tiene_app;
        tiene-notas: root.entrada.tiene_notas;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.abrir-menu-contextual(root.entrada.id, touch.mouse-x, touch.mouse-y);
            }
        }
        clicked => {
            if root.modo-seleccion {
                root.alternar-seleccion-lote();
            } else {
                root.clicked();
            }
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: entrada.es_hijo_grupo ? (Theme.estilo-indicadores == "lateral" ? 20px : 22px) : (Theme.estilo-indicadores == "lateral" ? 10px : 12px);
            padding-right: 12px;
            spacing: 10px;

            // ESTILO 4: Franja lateral izquierda
            if Theme.estilo-indicadores == "lateral" : IndicatorStrip {
                width: 4px;
                tiene-usuario: root.entrada.tiene_usuario;
                tiene-password: root.entrada.tiene_password;
                tiene-totp: root.entrada.tiene_totp;
                tiene-passkey: root.entrada.tiene_passkey;
                tiene-url: root.entrada.tiene_url;
                tiene-app: root.entrada.tiene_app;
                tiene-notas: root.entrada.tiene_notas;
            }

            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                SelectableAvatar {
                    seleccionado-lote: root.entrada.seleccionada_lote;
                    modo-seleccion: root.modo-seleccion;
                    hover-externo: touch.has-hover;
                    icono-base: root.entrada.tipo == "TARJETA" ? @image-url("../assets/icons/credit_card.svg") :
                                root.entrada.tipo == "CUENTA_BANCARIA" ? @image-url("../assets/icons/account_balance.svg") :
                                root.entrada.tipo == "SERVIDOR" ? @image-url("../assets/icons/computer.svg") :
                                root.entrada.tipo == "WIFI" ? @image-url("../assets/icons/wifi.svg") :
                                root.entrada.tipo == "WALLET" ? @image-url("../assets/icons/wallet.svg") :
                                root.entrada.tipo == "IDENTIDAD" ? @image-url("../assets/icons/badge.svg") :
                                root.entrada.tipo == "CONTACTO" ? @image-url("../assets/icons/person.svg") :
                                root.entrada.tipo == "NOTA" ? @image-url("../assets/icons/note.svg") :
                                @image-url("../assets/icons/key.svg");
                    alternar-seleccion => { root.alternar-seleccion-lote(); }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 4px;
                alignment: center;

                // Fila 1 (Superior)
                HorizontalLayout {
                    spacing: 8px;

                    // Izquierda: Título (limpio y prominente)
                    Text {
                        text: entrada.titulo;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    // Derecha: TOTP activo en monospace + cuenta regresiva + Estrella favorito
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        alignment: end;

                        if entrada.totp_codigo != "" : HorizontalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: entrada.totp_codigo;
                                color: Theme.accent-primary;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "(\{entrada.totp_restante}s)";
                                color: Theme.text-muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        if entrada.anclado : AppIcon {
                            source: @image-url("../assets/icons/pin.svg");
                            icon-size: 13px;
                            icon-color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        if entrada.favorito : AppIcon {
                            source: @image-url("../assets/icons/star.svg");
                            icon-size: 14px;
                            icon-color: #F59E0B;
                            vertical-alignment: center;
                        }
                    }
                }

                // Fila 2 (Inferior)
                HorizontalLayout {
                    spacing: 8px;

                    // Izquierda: Chip de Identidad/Perfil o Subtítulo (usuario / detalle)
                    if entrada.mostrar_chip_perfil : HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: start;

                        Rectangle {
                            height: 18px;
                            background: entrada.color_perfil.transparentize(86%);
                            border-radius: Theme.curvatura-esquinas > 4px ? Theme.curvatura-esquinas / 2 : 4px;
                            border-width: 0.8px;
                            border-color: entrada.color_perfil.transparentize(65%);

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;

                                if entrada.es_documento_perfil : AppIcon {
                                    source: @image-url("../assets/icons/badge.svg");
                                    icon-size: 10px;
                                    icon-color: entrada.color_perfil;
                                    vertical-alignment: center;
                                }

                                if !entrada.es_documento_perfil : Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: entrada.color_perfil;
                                }

                                Text {
                                    text: entrada.nombre_perfil;
                                    color: entrada.color_perfil;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if !entrada.mostrar_chip_perfil : Text {
                        text: entrada.subtitulo != "" ? entrada.subtitulo : "(sin usuario o detalle)";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    // Derecha: Indicadores de color alineados al borde derecho del contenedor
                    if Theme.estilo-indicadores == "iconos" : IndicatorIcons {
                        horizontal-stretch: 0;
                        tiene-usuario: root.entrada.tiene_usuario;
                        tiene-password: root.entrada.tiene_password;
                        tiene-totp: root.entrada.tiene_totp;
                        tiene-passkey: root.entrada.tiene_passkey;
                        tiene-url: root.entrada.tiene_url;
                        tiene-app: root.entrada.tiene_app;
                        tiene-notas: root.entrada.tiene_notas;
                    }

                    if Theme.estilo-indicadores == "puntos" : IndicatorDots {
                        horizontal-stretch: 0;
                        tiene-usuario: root.entrada.tiene_usuario;
                        tiene-password: root.entrada.tiene_password;
                        tiene-totp: root.entrada.tiene_totp;
                        tiene-passkey: root.entrada.tiene_passkey;
                        tiene-url: root.entrada.tiene_url;
                        tiene-app: root.entrada.tiene_app;
                        tiene-notas: root.entrada.tiene_notas;
                    }
                }
            }
        }
    }
}
